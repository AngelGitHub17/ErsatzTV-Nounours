@inherits LayoutComponentBase
@using System.Reflection
@using ErsatzTV.Application.Configuration
@using ErsatzTV.Application.Playouts
@using ErsatzTV.Application.Search
@using ErsatzTV.Core.Health
@using ErsatzTV.Core.Interfaces.Search
@using ErsatzTV.Core.Notifications
@using ErsatzTV.Extensions
@using MediatR.Courier
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IMediator Mediator
@inject SystemStartup SystemStartup
@inject ISearchTargets SearchTargets;
@inject ICourier Courier
@inject IHealthCheckService HealthCheckService;
@inject IStringLocalizer<ErsatzTV.Locals.Shared.MainLayout> StringLocalizer;
@inject ErsatzTV.Plugins.IPluginRegistry PluginRegistry
@inject ErsatzTV.Nounours.UiPreferences UiPreferences

<MudThemeProvider Theme="ErsatzTvTheme" IsDarkMode="_isDarkMode"/>
<MudDialogProvider BackdropClick="false"/>
<MudSnackbarProvider/>
<MudPopoverProvider/>

<MudLayout @onclick="@(() => _isOpen = false)" Class="@(_isDarkMode ? "d-flex d-flex-column ersatztv-dark nounours" : "d-flex d-flex-column ersatztv-light nounours")" Style="height: 100vh">
    <MudAppBar Elevation="0" Class="app-bar nounours-appbar">
        @if (SystemStartup.IsDatabaseReady && SystemStartup.IsSearchIndexReady)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" aria-label="Menu"/>
        }
        <a href="" class="nounours-brand d-none d-md-flex">
            <img src="images/ersatztv.png?v=2" alt=""/>
            <span class="nounours-brand-sub">édition<br/>Nounours</span>
        </a>
        @if (SystemStartup.IsDatabaseReady && SystemStartup.IsSearchIndexReady)
        {
            <div class="search-form">
                <EditForm Model="@_dummyModel" OnSubmit="@(_ => PerformSearch())">
                    <MudTextField T="string"
                                  @bind-Value="@Query"
                                  Placeholder="Rechercher un film, une série, une chaîne…"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Adornment="Adornment.Start"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Class="search-bar"
                                  @onclick="@(() => _isOpen = true)"
                                  OnKeyUp="@OnKeyUp">
                    </MudTextField>
                    <MudPopover Open="@_isOpen" MaxHeight="300" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" RelativeWidth="DropdownWidth.Relative">
                        @if (!string.IsNullOrWhiteSpace(_query) && _query.Length >= 3)
                        {
                            var matches = _searchTargets.Where(s => s.Name.Contains(_query, StringComparison.CurrentCultureIgnoreCase)).ToList();
                            if (matches.Any())
                            {
                                <MudList T="SearchTargetViewModel" ReadOnly="false" Dense="true">
                                    @foreach (SearchTargetViewModel searchTarget in matches)
                                    {
                                        <MudListItem @key="@searchTarget" OnClick="@(() => NavigateTo(searchTarget))">
                                            <MudText Typo="Typo.body1">@searchTarget.Name</MudText>
                                            <MudText Typo="Typo.subtitle1" Class="mud-text-disabled">
                                                @(
                                                searchTarget.Kind switch
                                                {
                                                    SearchTargetKind.Channel => "Chaîne",
                                                    SearchTargetKind.FFmpegProfile => "Profil FFmpeg",
                                                    SearchTargetKind.ChannelWatermark => "Filigrane",
                                                    SearchTargetKind.Collection => "Collection",
                                                    SearchTargetKind.MultiCollection => "Multi-collection",
                                                    SearchTargetKind.SmartCollection => "Collection intelligente",
                                                    SearchTargetKind.Schedule => "Planning",
                                                    SearchTargetKind.ScheduleItems => "Éléments du planning",
                                                    _ => string.Empty
                                                })
                                            </MudText>
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        }
                    </MudPopover>
                </EditForm>
            </div>
        }
        <div class="flex-grow-1 d-none d-md-flex"></div>
        <div style="align-items: center; display: flex;" class="d-none d-md-flex">
            @if (SystemStartup.IsDatabaseReady && SystemStartup.IsSearchIndexReady)
            {
                @if (BuildConfiguration != "release")
                {
                    <MudText Color="Color.Warning" Class="mx-4">@System.Environment.MachineName</MudText>
                }
                <MudButton Href="chaines/nouvelle" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddCircle" Class="mr-3">Nouvelle chaîne</MudButton>
                <MudMenu Icon="@Icons.Material.Filled.Link" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Liens IPTV">
                    <MudMenuItem Href="iptv/channels.m3u" Target="_blank" Icon="@Icons.Material.Filled.PlaylistPlay">Liste des chaînes (M3U)</MudMenuItem>
                    <MudMenuItem Href="iptv/xmltv.xml" Target="_blank" Icon="@Icons.Material.Filled.CalendarViewWeek">Guide des programmes (XMLTV)</MudMenuItem>
                    <MudMenuItem Href="docs" Target="_blank" Icon="@Icons.Material.Filled.Api">Documentation de l'API</MudMenuItem>
                </MudMenu>
            }
            <MudTooltip Text="Documentation ErsatzTV">
                <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Inherit" Href="https://ersatztv.org" Target="_blank"/>
            </MudTooltip>
            <AuthorizeView>
                <form action="/account/logout" method="post">
                    <MudTooltip Text="Se déconnecter">
                        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Secondary" ButtonType="ButtonType.Submit"/>
                    </MudTooltip>
                </form>
            </AuthorizeView>
        </div>
    </MudAppBar>
    @if (SystemStartup.IsDatabaseReady && SystemStartup.IsSearchIndexReady)
    {
        <MudDrawer @bind-Open="@_drawerIsOpen" Elevation="0" ClipMode="DrawerClipMode.Always" Class="nounours-drawer" Width="268px">
            <MudNavMenu Class="nounours-nav" Bordered="false">
                <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">Accueil</MudNavLink>
                @if (!_expert)
                {
                    @* ------------------------------------------------ menu simple : l'essentiel, dans l'ordre où on s'en sert *@
                    <div class="nounours-nav-section">Ma télé</div>
                    <MudNavLink Href="channels" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LiveTv">Mes chaînes</MudNavLink>
                    <MudNavLink Href="chaines/nouvelle" Icon="@Icons.Material.Filled.AddCircleOutline">Créer une chaîne</MudNavLink>
                    <MudNavLink Href="programmes" Icon="@Icons.Material.Filled.ViewAgenda">Programmes</MudNavLink>
                    <MudNavLink Href="planning" Icon="@Icons.Material.Filled.CalendarMonth">Planning</MudNavLink>
                    <MudNavLink Href="programmation-auto" Icon="@Icons.Material.Filled.AutoMode">Programmation auto</MudNavLink>
                    <MudNavLink Href="collections-films" Icon="@Icons.Material.Filled.CollectionsBookmark">Sagas et collections</MudNavLink>
                    <MudNavLink Href="regie" Icon="@Icons.Material.Filled.Podcasts">Régie (direct)</MudNavLink>
                    <MudNavLink Href="conducteur" Icon="@Icons.Material.Filled.ViewTimeline">Conducteur en direct</MudNavLink>
                    <MudNavLink Href="info" Icon="@Icons.Material.Filled.Newspaper">Info en continu</MudNavLink>
                    <MudNavLink Href="journal" Icon="@Icons.Material.Filled.History">Journal de diffusion</MudNavLink>
                    <MudNavLink Href="mur" Icon="@Icons.Material.Filled.GridView">Mur de chaînes</MudNavLink>

                    <div class="nounours-nav-section">À l'écran</div>
                    <MudNavLink Href="habillage" Icon="@Icons.Material.Filled.Layers">Habillage</MudNavLink>
                    <MudNavLink Href="atelier" Icon="@Icons.Material.Filled.MovieFilter">Atelier vidéo</MudNavLink>

                    <div class="nounours-nav-section">Mes médias</div>
                    <MudNavLink Href="medias" Icon="@Icons.Material.Filled.CreateNewFolder">Ajouter des médias</MudNavLink>
                    <MudNavLink Href="media/movies" Icon="@Icons.Material.Filled.Movie">Films</MudNavLink>
                    <MudNavLink Href="media/tv/shows" Icon="@Icons.Material.Filled.Tv">Séries</MudNavLink>
                    <MudNavLink Href="media/other/videos" Icon="@Icons.Material.Filled.VideoLibrary">Autres vidéos</MudNavLink>

                    var simplePluginLinks = PluginRegistry.Enabled.SelectMany(p => p.Plugin.NavItems.Select(n => (p.Plugin, n))).ToList();
                    @if (simplePluginLinks.Count > 0)
                    {
                        <div class="nounours-nav-section">Modules</div>
                        @foreach ((ErsatzTV.Plugins.IErsatzPlugin plugin, ErsatzTV.Plugins.PluginNavItem item) in simplePluginLinks)
                        {
                            <MudNavLink Href="@item.Href" Icon="@(item.Icon ?? plugin.Icon)">@item.Title</MudNavLink>
                        }
                    }

                    <div class="nounours-nav-section">Réglages</div>
                    <MudNavLink Href="settings/ui" Icon="@Icons.Material.Filled.Settings">Réglages</MudNavLink>
                    <MudNavLink Href="services" Icon="@Icons.Material.Filled.AutoMode">Services automatiques</MudNavLink>
                    <MudNavLink Href="sauvegarde" Icon="@Icons.Material.Filled.Backup">Sauvegarde</MudNavLink>
                    @if (_errors > 0 || _warnings > 0)
                    {
                        <MudNavLink Href="system/health" Icon="@Icons.Material.Filled.MonitorHeart">
                            <MudBadge Content="@(_errors > 0 ? _errors : _warnings)" Color="@(_errors > 0 ? Color.Error : Color.Warning)" Origin="Origin.CenterRight" BadgeClass="mx-3">À vérifier</MudBadge>
                        </MudNavLink>
                    }
                }
                else
                {

                    <MudNavGroup Title="Chaînes" Icon="@Icons.Material.Filled.LiveTv" Expanded="true">
                        <MudNavLink Href="channels" Match="NavLinkMatch.All">Mes chaînes</MudNavLink>
                        <MudNavLink Href="chaines/nouvelle">Nouvelle chaîne (assistant)</MudNavLink>
                        <MudNavLink Href="programmes">Programmes (conducteurs)</MudNavLink>
                        <MudNavLink Href="planning">Planning des programmes</MudNavLink>
                        <MudNavLink Href="programmation-auto">Programmation automatique</MudNavLink>
                        <MudNavLink Href="collections-films">Sagas et collections de films</MudNavLink>
                        <MudNavLink Href="semaine-type">Semaine type</MudNavLink>
                        <MudNavLink Href="regie">Régie (direct)</MudNavLink>
                        <MudNavLink Href="conducteur">Conducteur en direct</MudNavLink>
                        <MudNavLink Href="info">Info en continu</MudNavLink>
                        <MudNavLink Href="journal">Journal de diffusion</MudNavLink>
                        <MudNavLink Href="mur">Mur de chaînes</MudNavLink>
                        <MudNavLink Href="grille">Grille à imprimer</MudNavLink>
                        @if (_expert)
                        {
                            <MudNavLink Href="channels/numbers">Numérotation</MudNavLink>
                        }
                    </MudNavGroup>
    
                    <MudNavGroup Title="Habillage" Icon="@Icons.Material.Filled.Layers" Expanded="true">
                        <MudNavLink Href="habillage">Studio d'habillage</MudNavLink>
                        <MudNavLink Href="atelier">Atelier vidéo (jingles, BA)</MudNavLink>
                        <MudNavLink Href="importer">Pubs & jingles (import)</MudNavLink>
                        <MudNavLink Href="watermarks">Logos & filigranes</MudNavLink>
                    </MudNavGroup>
    
                    <MudNavGroup Icon="@Icons.Material.Filled.CalendarMonth">
                        <TitleContent>
                            <div style="align-items: center; display: flex">
                                Programmation
                                @if (_playoutWarnings > 0)
                                {
                                    <MudIcon Color="@Color.Warning" Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mx-2"/>
                                }
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudNavLink Href="schedules">Plannings</MudNavLink>
                            <MudNavLink Href="playouts">
                                @if (_playoutWarnings > 0)
                                {
                                    <MudBadge Content="_playoutWarnings" Color="Color.Warning" Origin="Origin.CenterRight" BadgeClass="mx-3">Playouts</MudBadge>
                                }
                                else
                                {
                                    @("Playouts")
                                }
                            </MudNavLink>
                            @if (_expert)
                            {
                                <MudNavLink Href="blocks">Blocs</MudNavLink>
                                <MudNavLink Href="templates">Modèles de journée</MudNavLink>
                                <MudNavLink Href="decos">Décos</MudNavLink>
                                <MudNavLink Href="deco-templates">Modèles de décos</MudNavLink>
                            }
                        </ChildContent>
                    </MudNavGroup>
    
                    <MudNavGroup Title="Médiathèque" Icon="@Icons.Material.Filled.VideoLibrary">
                        <MudNavLink Href="media/tv/shows">Séries</MudNavLink>
                        <MudNavLink Href="media/movies">Films</MudNavLink>
                        <MudNavLink Href="media/music/artists">Musique</MudNavLink>
                        <MudNavLink Href="media/other/videos">Autres vidéos</MudNavLink>
                        @if (_expert)
                        {
                            <MudNavLink Href="media/music/songs">Morceaux</MudNavLink>
                            <MudNavLink Href="media/browser/images">Images</MudNavLink>
                            <MudNavLink Href="media/remote/streams">Flux distants</MudNavLink>
                        }
                        <MudNavLink Href="media/libraries">Bibliothèques</MudNavLink>
                        <MudNavLink Href="media/trash">Corbeille</MudNavLink>
                    </MudNavGroup>
    
                    <MudNavGroup Title="Collections" Icon="@Icons.Material.Filled.CollectionsBookmark">
                        <MudNavLink Href="media/collections">Collections</MudNavLink>
                        <MudNavLink Href="media/smart-collections">Collections intelligentes</MudNavLink>
                        <MudNavLink Href="media/playlists">Playlists</MudNavLink>
                        @if (_expert)
                        {
                            <MudNavLink Href="media/multi-collections">Multi-collections</MudNavLink>
                            <MudNavLink Href="media/rerun-collections">Rediffusions</MudNavLink>
                            <MudNavLink Href="media/trakt/lists">Listes Trakt</MudNavLink>
                            <MudNavLink Href="media/filler/presets">Préréglages de remplissage</MudNavLink>
                        }
                    </MudNavGroup>
    
                    <MudNavGroup Title="Sources" Icon="@Icons.Material.Filled.Storage">
                        <MudNavLink Href="media/sources/local">Dossiers locaux</MudNavLink>
                        <MudNavLink Href="media/sources/plex">Plex</MudNavLink>
                        <MudNavLink Href="media/sources/jellyfin">Jellyfin</MudNavLink>
                        <MudNavLink Href="media/sources/emby">Emby</MudNavLink>
                    </MudNavGroup>
    
                    var pluginLinks = PluginRegistry.Enabled.SelectMany(p => p.Plugin.NavItems.Select(n => (p.Plugin, n))).ToList();
                    <MudNavGroup Title="Modules" Icon="@Icons.Material.Filled.Extension">
                        @foreach ((ErsatzTV.Plugins.IErsatzPlugin plugin, ErsatzTV.Plugins.PluginNavItem item) in pluginLinks)
                        {
                            <MudNavLink Href="@item.Href" Icon="@(item.Icon ?? plugin.Icon)">@item.Title</MudNavLink>
                        }
                        <MudNavLink Href="modules" Match="NavLinkMatch.All">Gérer les modules</MudNavLink>
                    </MudNavGroup>
    
                    <MudNavGroup Title="Réglages" Icon="@Icons.Material.Filled.Settings">
                        <MudNavLink Href="ffmpeg">Profils de diffusion (FFmpeg)</MudNavLink>
                        <MudNavLink Href="settings/ui">Interface</MudNavLink>
                        <MudNavLink Href="services">Services automatiques</MudNavLink>
                        <MudNavLink Href="sauvegarde">Sauvegarde</MudNavLink>
                        <MudNavLink Href="settings/playout">Programmation</MudNavLink>
                        <MudNavLink Href="settings/scanner">Analyse des bibliothèques</MudNavLink>
                        <MudNavLink Href="settings/xmltv">Guide XMLTV</MudNavLink>
                        @if (_expert)
                        {
                            <MudNavLink Href="settings/ffmpeg">FFmpeg</MudNavLink>
                            <MudNavLink Href="settings/hdhr">HDHomeRun</MudNavLink>
                            <MudNavLink Href="settings/logging">Journalisation</MudNavLink>
                        }
                    </MudNavGroup>
    
                    <MudNavGroup Icon="@Icons.Material.Filled.MonitorHeart">
                        <TitleContent>
                            <div style="align-items: center; display: flex">
                                Diagnostic
                                @if (_errors > 0)
                                {
                                    <MudIcon Color="@Color.Error" Icon="@Icons.Material.Filled.Error" Size="Size.Small" Class="mx-2"/>
                                }
                                else if (_warnings > 0)
                                {
                                    <MudIcon Color="@Color.Warning" Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mx-2"/>
                                }
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudNavLink Href="system/health">
                                @if (_errors > 0)
                                {
                                    <MudBadge Content="_errors" Color="Color.Error" Origin="Origin.CenterRight" BadgeClass="mx-3">État du système</MudBadge>
                                }
                                else if (_warnings > 0)
                                {
                                    <MudBadge Content="_warnings" Color="Color.Warning" Origin="Origin.CenterRight" BadgeClass="mx-3">État du système</MudBadge>
                                }
                                else
                                {
                                    @("État du système")
                                }
                            </MudNavLink>
                            <MudNavLink Href="system/logs">Journaux</MudNavLink>
                            <MudNavLink Href="system/troubleshooting">Dépannage</MudNavLink>
                        </ChildContent>
                    </MudNavGroup>
                }
            </MudNavMenu>

            <div class="nounours-drawer-footer">
                <MudTooltip Text="Affiche tous les menus et toutes les options avancées d'ErsatzTV (sources Plex/Jellyfin, blocs, décos, FFmpeg…)" Placement="Placement.Top">
                    <MudSwitch T="bool" Value="@_expert" ValueChanged="@ToggleExpert" Color="Color.Primary" Label="Toutes les options (expert)"/>
                </MudTooltip>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">ErsatzTV @InfoVersion</MudText>
                @if (BuildConfiguration != "release")
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">@BuildConfiguration</MudText>
                }
            </div>
        </MudDrawer>
    }
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private static readonly string InfoVersion = Assembly.GetEntryAssembly().GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "unknown";
    private static readonly string BuildConfiguration = Assembly.GetEntryAssembly().GetCustomAttribute<AssemblyConfigurationAttribute>()?.Configuration?.ToLower() ?? "unset";

    private CancellationTokenSource _cts;

    private string _query;

    private record SearchModel;

    private readonly SearchModel _dummyModel = new();
    private bool _drawerIsOpen = true;
    private bool _isOpen;
    private List<SearchTargetViewModel> _searchTargets;
    private int _playoutWarnings;
    private int _errors;
    private int _warnings;
    private bool _isDarkMode = true;
    private bool _expert;

    protected override void OnInitialized()
    {
        SystemStartup.OnDatabaseReady += OnStartupProgress;
        SystemStartup.OnSearchIndexReady += OnStartupProgress;

        SearchTargets.OnSearchTargetsChanged += OnSearchTargetsChanged;
        ErsatzTV.Nounours.UiPreferences.ExpertModeChanged += OnExpertModeChanged;

        Courier.Subscribe<HealthCheckSummary>(HandleHealthCheckSummary);
        Courier.Subscribe<PlayoutUpdatedNotification>(HandlePlayoutUpdated);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await HandleHealthCheckSummary(HealthCheckService.GetHealthCheckSummary(), CancellationToken.None);
    }

    public void Dispose()
    {
        SystemStartup.OnDatabaseReady -= OnStartupProgress;
        SystemStartup.OnSearchIndexReady -= OnStartupProgress;

        SearchTargets.OnSearchTargetsChanged -= OnSearchTargetsChanged;
        ErsatzTV.Nounours.UiPreferences.ExpertModeChanged -= OnExpertModeChanged;

        Courier.UnSubscribe<HealthCheckSummary>(HandleHealthCheckSummary);
        Courier.UnSubscribe<PlayoutUpdatedNotification>(HandlePlayoutUpdated);

        _cts?.Cancel();
        _cts?.Dispose();
    }

    private static MudTheme ErsatzTvTheme => new()
    {
        PaletteDark = new PaletteDark
        {
            ActionDefault = "rgba(255,255,255, 0.80)",
            Primary = "#4F8CFF",
            Secondary = "#FF7A45",
            Tertiary = "#22C55E",
            Info = "#38BDF8",
            Success = "#22C55E",
            Warning = "#F5B83D",
            Error = "#F05252",
            Surface = "#1C1F27",
            AppbarBackground = "#12141A",
            AppbarText = "rgba(255,255,255, 0.85)",
            DrawerBackground = "#161920",
            DrawerText = "rgba(255,255,255, 0.78)",
            DrawerIcon = "rgba(255,255,255, 0.60)",
            Divider = "rgba(255,255,255, 0.10)",
            DividerLight = "rgba(255,255,255, 0.06)",
            LinesDefault = "rgba(255,255,255, 0.10)",
            Background = "#111318",
            BackgroundGray = "#181B22",
            TextPrimary = "rgba(255,255,255, 0.92)",
            TextSecondary = "rgba(255,255,255, 0.62)",
            TextDisabled = "rgba(255,255,255, 0.38)",
            ActionDisabled = "rgba(255,255,255, 0.38)",
            TableHover = "rgba(255,255,255, 0.05)",
            TableLines = "rgba(255,255,255, 0.07)",
            White = Colors.Shades.White
        },

        PaletteLight = new PaletteLight
        {
            ActionDefault = "#4B5563",
            Primary = "#2F6FEB",
            Secondary = "#E8590C",
            Tertiary = "#16A34A",
            Info = "#0284C7",
            Success = "#16A34A",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1F2937",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#374151",
            Surface = "#FFFFFF",
            Background = "#F4F6FA",
            BackgroundGray = "#EEF1F6",
            TextPrimary = "#111827",
            TextSecondary = "rgba(17,24,39, 0.65)",
            TextDisabled = "rgba(17,24,39, 0.45)",
            ActionDisabled = "rgba(17,24,39, 0.3)",
            Divider = "rgba(17,24,39, 0.10)",
            TableHover = "rgba(17,24,39, 0.03)",
            TableLines = "rgba(17,24,39, 0.07)"
        },

        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px"
        },

        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Roboto", "Segoe UI", "system-ui", "sans-serif"] },
            H4 = new H4Typography { FontWeight = "700", LetterSpacing = "-.01em" },
            H5 = new H5Typography { FontWeight = "700" },
            H6 = new H6Typography { FontWeight = "600" },
            Button = new ButtonTypography { TextTransform = "none", FontWeight = "600" }
        }
    };

    private string Query
    {
        get => _query;
        set
        {
            if (_query == value)
            {
                return;
            }

            _query = value;
            _isOpen = true;
            StateHasChanged();
        }
    }

    private async void OnStartupProgress(object sender, EventArgs e)
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // do nothing
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!SystemStartup.IsDatabaseReady || !SystemStartup.IsSearchIndexReady)
        {
            string currentUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            if (!string.IsNullOrEmpty(currentUri))
            {
                NavigationManager.NavigateTo(string.Empty);
                return;
            }
        }

        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        try
        {
            await base.OnParametersSetAsync();
            _query = NavigationManager.Uri.GetSearchQuery();

            if (SystemStartup.IsDatabaseReady)
            {
                _searchTargets ??= await Mediator.Send(new QuerySearchTargets(), token);

                _isDarkMode = await Mediator.Send(new GetConfigElementByKey(ConfigElementKey.PagesIsDarkMode), token)
                    .MapT(result => !bool.TryParse(result.Value, out bool value) || value)
                    .IfNoneAsync(true);

                _playoutWarnings = await Mediator.Send(new GetPlayoutWarningsCount(), token);
                _expert = await UiPreferences.GetExpertMode(token);
            }
        }
        catch (OperationCanceledException)
        {
            // do nothing
        }
    }

    protected async void OnSearchTargetsChanged(object sender, EventArgs e)
    {
        try
        {
            _searchTargets = await Mediator.Send(new QuerySearchTargets(), _cts.Token);
        }
        catch (Exception)
        {
            // do nothing
        }
    }

    private void PerformSearch()
    {
        NavigationManager.NavigateTo(_query.GetRelativeSearchQuery(), true);
        StateHasChanged();
    }

    private void OnKeyUp(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Enter":
            case "NumpadEnter":
                _isOpen = false;
                break;
            case "Escape":
                _isOpen = false;
                break;
        }
    }

    private void NavigateTo(SearchTargetViewModel searchTarget) =>
        // need to force smart collections to navigate since the query string is all that differs
        NavigationManager.NavigateTo(UrlFor(searchTarget), searchTarget.Kind is SearchTargetKind.SmartCollection);

    private string UrlFor(SearchTargetViewModel searchTarget) =>
        searchTarget.Kind switch
        {
            SearchTargetKind.Channel => $"channels/{searchTarget.Id}",
            SearchTargetKind.FFmpegProfile => $"ffmpeg/{searchTarget.Id}",
            SearchTargetKind.ChannelWatermark => $"watermarks/{searchTarget.Id}",
            SearchTargetKind.Collection => $"media/collections/{searchTarget.Id}",
            SearchTargetKind.MultiCollection => $"media/multi-collections/{searchTarget.Id}/edit",
            SearchTargetKind.SmartCollection when searchTarget is SmartCollectionSearchTargetViewModel sc =>
                sc.Query.GetRelativeSearchQuery(),
            SearchTargetKind.Schedule => $"schedules/{searchTarget.Id}",
            SearchTargetKind.ScheduleItems => $"schedules/{searchTarget.Id}/items",
            _ => null
        };

    private void ToggleDrawer() => _drawerIsOpen = !_drawerIsOpen;

    private async Task ToggleExpert(bool value)
    {
        _expert = value;
        await UiPreferences.SetExpertMode(value, CancellationToken.None);
    }

    private async void OnExpertModeChanged(object sender, EventArgs e)
    {
        try
        {
            _expert = await UiPreferences.GetExpertMode(CancellationToken.None);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // ignore
        }
    }

    private async Task HandleHealthCheckSummary(HealthCheckSummary healthCheckSummary, CancellationToken cancellationToken)
    {
        try
        {
            if (healthCheckSummary.Errors > 0)
            {
                _errors = healthCheckSummary.Errors;
                _warnings = 0;
            }
            else if (healthCheckSummary.Warnings > 0)
            {
                _warnings = healthCheckSummary.Warnings;
                _errors = 0;
            }
            else
            {
                _warnings = 0;
                _errors = 0;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // ignore
        }
    }

    private async Task HandlePlayoutUpdated(PlayoutUpdatedNotification _, CancellationToken cancellationToken)
    {
        try
        {
            _playoutWarnings = await Mediator.Send(new GetPlayoutWarningsCount(), cancellationToken);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // do nothing
        }
    }

}
