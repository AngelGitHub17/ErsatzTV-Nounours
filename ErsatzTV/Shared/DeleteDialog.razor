<div @onkeydown="@OnKeyDown">
    <MudDialog>
        <DialogContent>
            <MudContainer>
                <MudHighlighter Class="mud-primary-text"
                                Style="background-color: transparent; font-weight: bold"
                                Text="@FormatText()"
                                HighlightedText="@EntityName"/>
            </MudContainer>
            @if (!string.IsNullOrWhiteSpace(DetailText))
            {
                <MudContainer Class="mt-3">
                    <MudHighlighter Class="mud-primary-text"
                                    Style="background-color: transparent; font-weight: bold"
                                    Text="@DetailText"
                                    HighlightedText="@DetailHighlight"/>
                </MudContainer>
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Annuler</MudButton>
            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Submit">Supprimer</MudButton>
        </DialogActions>
    </MudDialog>
</div>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public string EntityType { get; set; }

    [Parameter]
    public string EntityName { get; set; }

    [Parameter]
    public string DetailText { get; set; }

    [Parameter]
    public string DetailHighlight { get; set; }

    private static readonly Dictionary<string, string> Types = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Trakt List"] = "la liste Trakt", ["artist"] = "l'artiste", ["block group"] = "le groupe de blocs", ["block"] = "le bloc",
        ["channel"] = "la chaîne", ["collection"] = "la collection", ["deco group"] = "le groupe de décos", ["deco"] = "la déco",
        ["decoTemplate group"] = "le groupe de modèles de déco", ["decoTemplate"] = "le modèle de déco", ["episode"] = "l'épisode",
        ["ffmpeg profile"] = "le profil FFmpeg", ["filler preset"] = "le préréglage de remplissage", ["image"] = "l'image",
        ["library path"] = "le dossier", ["library"] = "la bibliothèque", ["movie"] = "le film", ["multi collection"] = "la multi-collection",
        ["music video"] = "le clip", ["other video"] = "la vidéo", ["playlist group"] = "le groupe de playlists", ["playlist"] = "la playlist",
        ["playout"] = "le playout", ["remote stream"] = "le flux distant", ["rerun collection"] = "la collection de rediffusion",
        ["schedule"] = "le planning", ["season"] = "la saison", ["show"] = "la série", ["smart collection"] = "la collection intelligente",
        ["song"] = "le morceau", ["template group"] = "le groupe de modèles", ["template"] = "le modèle", ["watermark"] = "le filigrane"
    };

    private string FormatText() =>
        $"Voulez-vous vraiment supprimer {(Types.TryGetValue(EntityType ?? string.Empty, out string label) ? label : EntityType)} {EntityName} ? Cette action est irréversible.";

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Code is "Enter" or "NumpadEnter")
        {
            Submit();
        }
    }

}
