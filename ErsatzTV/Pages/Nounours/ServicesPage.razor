@page "/services"
@using System.Globalization
@using ErsatzTV.Application.Channels
@using ErsatzTV.Application.Nounours
@using ErsatzTV.Application.Nounours.Atelier
@using ErsatzTV.Shared.Nounours
@inject IAutomationService Automation
@inject IRegieService Regie
@inject AtelierService Atelier
@inject IMediator Mediator
@inject ISnackbar Snackbar

<PageTitle>Services automatiques · ErsatzTV</PageTitle>

<div class="n-page" style="height: 100%; overflow-y: auto">
    <div class="n-page-header">
        <div>
            <h1>Services automatiques</h1>
            <p>Ce qu'ErsatzTV fait tout seul : publier le guide sur votre site, fabriquer le carton « Ce soir », la bande-annonce de la semaine et la météo, passer l'ouverture et la fermeture d'antenne, supprimer les chaînes éphémères. Et les serveurs de voix off / sous-titres.</p>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="@Save">Enregistrer</MudButton>
    </div>

    <MudGrid Spacing="3">
        @* ------------------------------------------------ publication *@
        <MudItem xs="12" lg="6">
            <div class="n-card" style="height: 100%">
                <div class="n-card-title">Publication du guide sur votre site</div>
                <MudSwitch T="bool" @bind-Value="_s.Publish.Enabled" Color="Color.Primary" Label="Envoyer automatiquement le guide"/>
                <MudTextField @bind-Value="_s.Publish.Url" Label="Adresse du script de réception" Placeholder="https://ntvbydidikaria.fr/guide/recevoir-guide.php" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"/>
                <div class="d-flex gap-2 align-start mt-2">
                    <MudTextField @bind-Value="_s.Publish.Token" Label="Jeton (le même que dans le script PHP)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex: 1"/>
                    <MudTooltip Text="Générer un jeton"><MudIconButton Icon="@Icons.Material.Filled.Key" OnClick="@NewToken" Style="margin-top: 4px"/></MudTooltip>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <MudNumericField @bind-Value="_s.Publish.IntervalMinutes" Label="Toutes les (minutes)" Min="5" Max="1440" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudNumericField @bind-Value="_s.Publish.Hours" Label="Heures de programme envoyées" Min="1" Max="336" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </div>
                <MudTextField @bind-Value="_s.PublicAddress" Label="Adresse d'ErsatzTV vue depuis Internet" Placeholder="http://mon-adresse:8409" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"
                              HelperText="Sert aux logos et aux liens « regarder » du guide publié"/>
                <div class="d-flex gap-2 align-center mt-3 flex-wrap">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Send" OnClick="@PublishNow" Disabled="@_busy">Envoyer maintenant</MudButton>
                    <a class="mud-button-root mud-button mud-button-text mud-button-text-default mud-button-text-size-medium" href="nounours/recevoir-guide.php.txt" download="recevoir-guide.php" style="padding: 6px 8px">recevoir-guide.php</a>
                    <a class="mud-button-root mud-button mud-button-text mud-button-text-default mud-button-text-size-medium" href="nounours/guide.php.txt" download="guide.php" style="padding: 6px 8px">guide.php (page d'exemple)</a>
                </div>
                @if (!string.IsNullOrEmpty(_s.Publish.LastResult))
                {
                    <MudText Typo="Typo.caption" Class="n-muted d-block mt-2">Dernier envoi @_s.Publish.LastSent?.ToString("dd/MM HH:mm", Fr) : @_s.Publish.LastResult</MudText>
                }
                <MudText Typo="Typo.body2" Class="n-muted mt-2">Déposez <b>recevoir-guide.php</b> sur votre hébergement (OVH…), mettez-y le même jeton : il enregistre <code>guide.json</code>. <b>guide.php</b> en fait une page « programme TV ».</MudText>
            </div>
        </MudItem>

        @* ------------------------------------------------ ce soir *@
        <MudItem xs="12" lg="6">
            <div class="n-card" style="height: 100%">
                <div class="n-card-title">Carton « Ce soir », fabriqué chaque jour</div>
                <MudSwitch T="bool" @bind-Value="_s.Tonight.Enabled" Color="Color.Primary" Label="Le fabriquer automatiquement"/>
                <div class="d-flex gap-2 mt-2">
                    <MudTextField @bind-Value="_s.Tonight.At" Label="Fabriqué à" Placeholder="17:00" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudTextField @bind-Value="_s.Tonight.From" Label="Soirée de" Placeholder="20:00" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudTextField @bind-Value="_s.Tonight.Until" Label="à" Placeholder="23:59" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </div>
                <div class="d-flex gap-1 flex-wrap mt-2 align-center">
                    <span class="n-muted" style="font-size: .85rem">Chaînes :</span>
                    @foreach (ChannelViewModel channel in _channels)
                    {
                        bool on = _s.Tonight.ChannelIds.Contains(channel.Id);
                        <MudChip T="int" Size="Size.Small" Color="@(on ? Color.Primary : Color.Default)" Variant="@(on ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => { if (!_s.Tonight.ChannelIds.Remove(channel.Id)) { _s.Tonight.ChannelIds.Add(channel.Id); } })">@channel.Number · @channel.Name</MudChip>
                    }
                </div>
                <div class="d-flex gap-2 mt-2">
                    <MudTextField @bind-Value="_s.Tonight.Title" Label="Titre" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudTextField @bind-Value="_s.Tonight.ChannelName" Label="Nom de la chaîne" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudNumericField @bind-Value="_s.Tonight.Seconds" Label="Durée (s)" Min="4" Max="60" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </div>
                <div class="mt-2"><SourcePicker Value="@_s.Tonight.Music" ValueChanged="@(v => _s.Tonight.Music = v)" EmptyLabel="Sans musique"/></div>
                <div class="d-flex gap-2 align-center mt-3 flex-wrap">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Preview" OnClick="@PreviewTonight">Voir la liste</MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Movie" OnClick="@MakeTonight" Disabled="@_busy">Fabriquer maintenant</MudButton>
                </div>
                @if (_tonightRows is not null)
                {
                    <div class="mt-2" style="font-size: .9rem">
                        @foreach ((string time, string title, string channel) in _tonightRows)
                        {
                            <div><b>@time</b> · @title @(channel is null ? "" : $"({channel})")</div>
                        }
                        @if (_tonightRows.Count == 0)
                        {
                            <div class="n-muted">Rien de programmé sur cette plage.</div>
                        }
                    </div>
                }
                @BroadcastEditor(_s.Tonight.Broadcast)
                <JobCard Job="@_job"/>
                <MudText Typo="Typo.body2" Class="n-muted mt-2">Le carton est toujours le même fichier (« Bandes-annonces ») : mettez-le une fois dans un programme ou un créneau avant la soirée, il se met à jour tout seul chaque jour.</MudText>
            </div>
        </MudItem>

        @* ------------------------------------------------ cette semaine *@
        <MudItem xs="12" lg="6">
            <div class="n-card" style="height: 100%">
                <div class="n-card-title">Bande-annonce « Cette semaine », refaite chaque semaine</div>
                <MudSwitch T="bool" @bind-Value="_s.Weekly.Enabled" Color="Color.Primary" Label="La fabriquer automatiquement"/>
                <div class="d-flex gap-2 mt-2">
                    <MudSelect T="DayOfWeek" @bind-Value="_s.Weekly.Day" Label="Le" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (DayOfWeek day in Week)
                        {
                            <MudSelectItem Value="@day">@Fr.DateTimeFormat.GetDayName(day)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_s.Weekly.At" Label="à" Placeholder="08:00" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudNumericField @bind-Value="_s.Weekly.MaxFilms" Label="Films (max)" Min="1" Max="8" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </div>
                @ChannelChips(_s.Weekly.ChannelIds)
                <div class="d-flex gap-2 mt-2">
                    <MudTextField @bind-Value="_s.Weekly.Label" Label="Étiquette" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudTextField @bind-Value="_s.Weekly.ChannelName" Label="Nom de la chaîne" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </div>
                <div class="mt-2"><SourcePicker Value="@_s.Weekly.Music" ValueChanged="@(v => _s.Weekly.Music = v)" EmptyLabel="Le son des films"/></div>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Theaters" OnClick="@MakeWeekly" Disabled="@_busy" Class="mt-3">Fabriquer maintenant</MudButton>
                @if (!string.IsNullOrEmpty(_s.Weekly.LastResult))
                {
                    <MudText Typo="Typo.caption" Class="n-muted d-block mt-2">Dernière fois (@_s.Weekly.LastMade?.ToString("dd/MM", Fr)) : @_s.Weekly.LastResult</MudText>
                }
                @BroadcastEditor(_s.Weekly.Broadcast)
                <JobCard Job="@_weeklyJob"/>
                <MudText Typo="Typo.body2" Class="n-muted mt-2">Les films des 7 prochains jours trouvés dans le guide : deux extraits chacun, avec le jour et l'heure de diffusion. Toujours le même fichier (« Bandes-annonces ») : mettez-le une fois dans vos programmes.</MudText>
            </div>
        </MudItem>

        @* ------------------------------------------------ météo *@
        <MudItem xs="12" lg="6">
            <div class="n-card" style="height: 100%">
                <div class="n-card-title">Carte météo en quadrillage, chaque jour</div>
                <MudSwitch T="bool" @bind-Value="_s.Weather.Enabled" Color="Color.Primary" Label="La fabriquer automatiquement"/>
                <div class="d-flex gap-2 mt-2">
                    <MudTextField @bind-Value="_s.Weather.At" Label="Fabriquée à" Placeholder="06:00" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudTextField @bind-Value="_s.Weather.Title" Label="Titre" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudNumericField @bind-Value="_s.Weather.Seconds" Label="Durée (s)" Min="4" Max="60" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </div>
                <MudTextField @bind-Value="_s.Weather.Cities" Label="Villes (une par ligne, 6 au plus)" Lines="4" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"/>
                <MudTextField @bind-Value="_s.Weather.ChannelName" Label="Nom de la chaîne" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"/>
                <div class="mt-2"><SourcePicker Value="@_s.Weather.Music" ValueChanged="@(v => _s.Weather.Music = v)" EmptyLabel="Sans musique"/></div>
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Preview" OnClick="@PreviewWeather" Disabled="@_busy">Voir les températures</MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.WbSunny" OnClick="@MakeWeather" Disabled="@_busy">Fabriquer maintenant</MudButton>
                </div>
                @if (_weatherRows is not null)
                {
                    <div class="mt-2" style="font-size: .9rem">
                        @foreach (WeatherRow row in _weatherRows)
                        {
                            <div><b>@row.Temperature</b> · @row.City · @row.Detail</div>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(_s.Weather.LastResult))
                {
                    <MudText Typo="Typo.caption" Class="n-muted d-block mt-2">Dernière fois (@_s.Weather.LastMade?.ToString("dd/MM", Fr)) : @_s.Weather.LastResult</MudText>
                }
                @BroadcastEditor(_s.Weather.Broadcast)
                <JobCard Job="@_weatherJob"/>
                <MudText Typo="Typo.body2" Class="n-muted mt-2">Températures d'Open-Meteo (gratuit, sans clé). Toujours le même fichier (« Bandes-annonces ») : placez-le dans un programme du matin.</MudText>
            </div>
        </MudItem>

        @* ------------------------------------------------ l'essentiel du jour *@
        <MudItem xs="12" lg="6">
            <div class="n-card" style="height: 100%">
                <div class="n-card-title">« L'essentiel du jour »</div>
                <MudText Typo="Typo.body2" Class="n-muted mb-2">Les titres de l'info (les vôtres et ceux de vos sites, page Info) : un par écran dans le quadrillage, le nom du site en étiquette, lus par la voix off. Refait aux heures choisies avec les titres du moment.</MudText>
                <MudSwitch T="bool" @bind-Value="_s.Essential.Enabled" Color="Color.Primary" Label="Le fabriquer automatiquement"/>
                <div class="d-flex gap-2 mt-2">
                    <MudTextField @bind-Value="_s.Essential.At" Label="Fabriqué à" Placeholder="12:30, 19:00" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudTextField @bind-Value="_s.Essential.Title" Label="Étiquette" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudNumericField @bind-Value="_s.Essential.Items" Label="Titres" Min="1" Max="8" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 100px"/>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <MudSelect T="VoiceEngine" @bind-Value="_s.Essential.Voice" Label="Voix off" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="VoiceEngine.None">Sans voix (titres à l'écran)</MudSelectItem>
                        <MudSelectItem Value="VoiceEngine.Windows">Voix de Windows (française si installée)</MudSelectItem>
                        <MudSelectItem Value="VoiceEngine.Server">Serveur de synthèse (réglé plus bas)</MudSelectItem>
                    </MudSelect>
                    @if (_s.Essential.Voice == VoiceEngine.None)
                    {
                        <MudNumericField @bind-Value="_s.Essential.Seconds" Label="Secondes par titre" Min="3" Max="20" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 170px"/>
                    }
                </div>
                <MudTextField @bind-Value="_s.Essential.ChannelName" Label="Nom de la chaîne" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"/>
                <div class="mt-2"><SourcePicker Value="@_s.Essential.Music" ValueChanged="@(v => _s.Essential.Music = v)" EmptyLabel="Pulsation régulière"/></div>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Newspaper" OnClick="@MakeEssential" Disabled="@_busy" Class="mt-3">Fabriquer maintenant</MudButton>
                @if (!string.IsNullOrEmpty(_s.Essential.LastResult))
                {
                    <MudText Typo="Typo.caption" Class="n-muted d-block mt-2">Dernière fois (@_s.Essential.LastMadeAt?.ToLocalTime().ToString("dd/MM HH:mm", Fr)) : @_s.Essential.LastResult</MudText>
                }
                @BroadcastEditor(_s.Essential.Broadcast)
                <JobCard Job="@_essentialJob"/>
                <MudText Typo="Typo.body2" Class="n-muted mt-2">Toujours le même fichier (« Bandes-annonces ») : il se met à jour tout seul là où vous l'avez placé, et passe aux heures de diffusion ci-dessus.</MudText>
            </div>
        </MudItem>

        @* ------------------------------------------------ interlude *@
        <MudItem xs="12" lg="6">
            <div class="n-card" style="height: 100%">
                <div class="n-card-title">Interlude quadrillé</div>
                <MudText Typo="Typo.body2" Class="n-muted mb-2">Une boucle de carrés au rythme d'une musique, qui passe quand une chaîne n'a rien de prévu, à la place d'un écran noir.</MudText>
                <div class="d-flex gap-2">
                    <MudTextField @bind-Value="_interludeLabel" Label="Étiquette" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudTextField @bind-Value="_interludeChannel" Label="Nom de la chaîne" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudNumericField @bind-Value="_interludeSeconds" Label="Durée (s)" Min="10" Max="300" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </div>
                <div class="mt-2"><SourcePicker Value="@_interludeMusic" ValueChanged="@(v => _interludeMusic = v)" EmptyLabel="Pulsation régulière"/></div>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.GridView" OnClick="@MakeInterlude" Disabled="@_busy" Class="mt-3">Fabriquer l'interlude</MudButton>
                <JobCard Job="@_interludeJob"/>
                @ChannelChips(_interludeChannels)
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Check" OnClick="@UseInterlude" Disabled="@(_busy || _interludeChannels.Count == 0)" Class="mt-2">L'utiliser sur ces chaînes</MudButton>
                @BroadcastEditor(_s.InterludeBroadcast)
                <MudText Typo="Typo.body2" Class="n-muted mt-2">Il devient le « remplissage de secours » de ces chaînes. L'heure s'affiche si l'habillage de la chaîne a une horloge et « Afficher aussi pendant les intercalaires ».</MudText>
            </div>
        </MudItem>

        @* ------------------------------------------------ rendez-vous *@
        <MudItem xs="12" lg="6">
            <div class="n-card" style="height: 100%">
                <div class="n-card-title">Rendez-vous d'antenne (ouverture, fermeture…)</div>
                <MudText Typo="Typo.body2" Class="n-muted mb-2">À l'heure dite, la régie passe une vidéo une fois, puis la grille reprend exactement où elle en était. Fabriquez la vidéo dans l'Atelier (Annonce « BONJOUR », Carton « BONNE NUIT »…).</MudText>
                @foreach (Appointment a in _s.Appointments)
                {
                    <div class="d-flex align-center gap-2 mb-1" @key="a.Id">
                        <MudSwitch T="bool" @bind-Value="a.Enabled" Color="Color.Primary" Size="Size.Small"/>
                        <span style="flex: 1"><b>@a.At</b> · @a.Name · @(_regieChannels.Find(c => c.PlayoutId == a.PlayoutId)?.Name ?? "?") · @a.MediaTitle · @(a.Days.Count == 0 ? "tous les jours" : string.Join(" ", a.Days.Select(d => Fr.DateTimeFormat.GetAbbreviatedDayName(d))))</span>
                        @if (!string.IsNullOrEmpty(a.LastResult))
                        {
                            <span class="n-muted" style="font-size: .8rem">@a.LastRun?.ToString("dd/MM", Fr) @a.LastResult</span>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _s.Appointments.Remove(a))"/>
                    </div>
                }
                <div class="d-flex gap-2 mt-2 flex-wrap">
                    <MudTextField @bind-Value="_newAppointment.Name" Label="Nom" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudTextField @bind-Value="_newAppointment.At" Label="Heure" Placeholder="06:00" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 100px"/>
                    <MudSelect T="int" @bind-Value="_newAppointment.PlayoutId" Label="Chaîne" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 160px">
                        @foreach (RegieChannel channel in _regieChannels)
                        {
                            <MudSelectItem Value="@channel.PlayoutId">@channel.Number · @channel.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <MudAutocomplete T="RegieSource" Value="@_newSource" ValueChanged="@(v => _newSource = v)" SearchFunc="@SearchSources" ToStringFunc="@(x => x?.Title)" Label="Vidéo"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" DebounceInterval="300" MinCharacters="0">
                    <ItemTemplate Context="item"><div><b>@item.Title</b> <span class="n-muted">· @item.Detail</span></div></ItemTemplate>
                </MudAutocomplete>
                <div class="d-flex gap-1 flex-wrap mt-2 align-center">
                    <span class="n-muted" style="font-size: .85rem">Jours (aucun = tous) :</span>
                    @foreach (DayOfWeek day in Week)
                    {
                        bool on = _newAppointment.Days.Contains(day);
                        <MudChip T="string" Size="Size.Small" Color="@(on ? Color.Primary : Color.Default)" Variant="@(on ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => { if (!_newAppointment.Days.Remove(day)) { _newAppointment.Days.Add(day); } })">@Fr.DateTimeFormat.GetAbbreviatedDayName(day)</MudChip>
                    }
                </div>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="@AddAppointment" Class="mt-2"
                           Disabled="@(_newAppointment.PlayoutId == 0 || _newSource is null || !TimeSpan.TryParse(_newAppointment.At, CultureInfo.InvariantCulture, out _))">Ajouter le rendez-vous</MudButton>
            </div>
        </MudItem>

        @* ------------------------------------------------ son *@
        <MudItem xs="12" lg="6">
            <div class="n-card" style="height: 100%">
                <div class="n-card-title">Même volume partout</div>
                <MudSwitch T="bool" Value="@_sameVolume" ValueChanged="@SetSameVolume" Color="Color.Primary" Label="Volume identique entre les programmes, les pubs et les chaînes"/>
                <MudText Typo="Typo.body2" Class="n-muted mt-1">Le son de chaque programme est ramené au même niveau perçu pendant la diffusion (norme EBU R128, comme à la télé : −16 LUFS ici). Fini la pub qui crie après un film calme. Demande un peu plus de calcul au PC.</MudText>
            </div>
        </MudItem>

        @* ------------------------------------------------ chaînes éphémères *@
        <MudItem xs="12" lg="6">
            <div class="n-card" style="height: 100%">
                <div class="n-card-title">Chaînes éphémères</div>
                <MudText Typo="Typo.body2" Class="n-muted mb-2">Une chaîne pour un week-end ou un événement : elle est supprimée toute seule à la date choisie (aussi réglable dans l'assistant de création).</MudText>
                @foreach ((int id, DateTimeOffset when) in _s.EphemeralChannels.OrderBy(e => e.Value))
                {
                    ChannelViewModel channel = _channels.Find(c => c.Id == id);
                    <div class="d-flex align-center gap-2 mb-1">
                        <span style="flex: 1">@(channel is null ? $"Chaîne n° {id}" : $"{channel.Number} · {channel.Name}")</span>
                        <span class="n-muted">supprimée le @when.ToString("dd/MM/yyyy HH:mm", Fr)</span>
                        <MudTooltip Text="La garder"><MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _s.EphemeralChannels.Remove(id))"/></MudTooltip>
                    </div>
                }
                <div class="d-flex gap-2 align-start mt-2 flex-wrap">
                    <MudSelect T="int" @bind-Value="_ephemeralChannel" Label="Chaîne" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 200px">
                        @foreach (ChannelViewModel channel in _channels)
                        {
                            <MudSelectItem Value="@channel.Id">@channel.Number · @channel.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudDatePicker @bind-Date="_ephemeralDate" Label="Supprimer le" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Culture="@Fr" MinDate="@DateTime.Today" Style="max-width: 170px"/>
                    <MudButton Variant="Variant.Outlined" OnClick="@AddEphemeral" Disabled="@(_ephemeralChannel == 0 || _ephemeralDate is null)" Style="margin-top: 4px">Ajouter</MudButton>
                </div>
            </div>
        </MudItem>

        @* ------------------------------------------------ serveurs *@
        <MudItem xs="12" lg="6">
            <div class="n-card" style="height: 100%">
                <div class="n-card-title">Serveurs de voix off et de sous-titres</div>
                <MudText Typo="Typo.body2" Class="n-muted mb-2">Facultatifs. Compatibles avec l'API d'OpenAI : par exemple un serveur Chatterbox TTS (voix) et faster-whisper-server (sous-titres) sur votre Proxmox. Sous Windows, la voix intégrée marche sans serveur.</MudText>
                <MudTextField @bind-Value="_s.Voice.Url" Label="Synthèse vocale : adresse (/v1/audio/speech)" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                <div class="d-flex gap-2 mt-2">
                    <MudTextField @bind-Value="_s.Voice.Model" Label="Modèle" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudTextField @bind-Value="_s.Voice.VoiceName" Label="Voix" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudTextField @bind-Value="_s.Voice.ApiKey" Label="Clé (facultatif)" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </div>
                <MudTextField @bind-Value="_s.Subtitles.Url" Label="Transcription : adresse (/v1/audio/transcriptions)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4"/>
                <div class="d-flex gap-2 mt-2">
                    <MudTextField @bind-Value="_s.Subtitles.Model" Label="Modèle" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudTextField @bind-Value="_s.Subtitles.Language" Label="Langue" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 90px"/>
                    <MudTextField @bind-Value="_s.Subtitles.ApiKey" Label="Clé (facultatif)" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </div>
                <MudText Typo="Typo.body2" Class="n-muted mt-2">Les sous-titres se fabriquent dans l'<MudLink Href="atelier" Typo="Typo.body2">Atelier vidéo</MudLink> (onglet « Sous-titres »).</MudText>
            </div>
        </MudItem>
    </MudGrid>
</div>

@code {
    private static readonly CultureInfo Fr = CultureInfo.GetCultureInfo("fr-FR");
    private NounoursSettings _s = new();
    private List<ChannelViewModel> _channels = [];
    private List<(string Time, string Title, string Channel)> _tonightRows;
    private AtelierJob _job;
    private bool _busy;
    private int _ephemeralChannel;
    private DateTime? _ephemeralDate;

    protected override async Task OnInitializedAsync()
    {
        _s = NounoursSettings.Load();
        _channels = (await Mediator.Send(new GetAllChannels()))
            .OrderBy(c => double.TryParse(c.Number, NumberStyles.Number, CultureInfo.InvariantCulture, out double n) ? n : 0)
            .ToList();
        _regieChannels = await Regie.GetChannels(CancellationToken.None);
        _sameVolume = await Automation.IsSameVolume(CancellationToken.None);
    }

    private void Save()
    {
        NounoursSettings current = _s;
        NounoursSettings.Update(s =>
        {
            s.PublicAddress = current.PublicAddress;
            s.Voice = current.Voice;
            s.Subtitles = current.Subtitles;
            DateTimeOffset? lastSent = s.Publish.LastSent;
            string lastResult = s.Publish.LastResult;
            s.Publish = current.Publish;
            s.Publish.LastSent = lastSent;
            s.Publish.LastResult = lastResult;
            DateOnly? lastMade = s.Tonight.LastMade;
            s.Tonight = current.Tonight;
            s.Tonight.LastMade = lastMade;
            s.EphemeralChannels = current.EphemeralChannels;
            (DateOnly? weeklyMade, string weeklyResult) = (s.Weekly.LastMade, s.Weekly.LastResult);
            s.Weekly = current.Weekly;
            (s.Weekly.LastMade, s.Weekly.LastResult) = (weeklyMade, weeklyResult);
            (DateOnly? weatherMade, string weatherResult) = (s.Weather.LastMade, s.Weather.LastResult);
            s.Weather = current.Weather;
            (s.Weather.LastMade, s.Weather.LastResult) = (weatherMade, weatherResult);
            (DateTimeOffset? essentialMade, string essentialResult) = (s.Essential.LastMadeAt, s.Essential.LastResult);
            s.Essential = current.Essential;
            (s.Essential.LastMadeAt, s.Essential.LastResult) = (essentialMade, essentialResult);
            // rendez-vous : garder la trace des derniers passages
            foreach (Appointment a in current.Appointments)
            {
                Appointment saved = s.Appointments.FirstOrDefault(x => x.Id == a.Id);
                if (saved is not null)
                {
                    (a.LastRun, a.LastResult) = (saved.LastRun, saved.LastResult);
                }
            }

            s.Appointments = current.Appointments;
            s.InterludeBroadcast = current.InterludeBroadcast;
        });
        Snackbar.Add("Réglages enregistrés.", Severity.Success);
    }

    private void NewToken() => _s.Publish.Token = Convert.ToHexString(System.Security.Cryptography.RandomNumberGenerator.GetBytes(16)).ToLowerInvariant();

    private async Task PublishNow()
    {
        Save();
        _busy = true;
        try
        {
            string result = await Automation.PublishGuide(CancellationToken.None);
            _s = NounoursSettings.Load();
            Snackbar.Add(result, result.StartsWith("Envoyé", StringComparison.Ordinal) ? Severity.Success : Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PreviewTonight() => _tonightRows = await Automation.TonightRows(_s.Tonight, CancellationToken.None);

    private async Task MakeTonight()
    {
        Save();
        _busy = true;
        try
        {
            _job = await Automation.MakeTonight(CancellationToken.None);
            _ = PollJob();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PollJob()
    {
        while (_job is { State: AtelierJobState.Running })
        {
            await Task.Delay(1000);
            await InvokeAsync(StateHasChanged);
        }

        await InvokeAsync(StateHasChanged);
    }

    private static readonly DayOfWeek[] Week =
        [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];

    private bool _sameVolume;

    private async Task SetSameVolume(bool on)
    {
        int count = await Automation.SetSameVolume(on, CancellationToken.None);
        _sameVolume = on;
        Snackbar.Add(on ? $"Volume identique activé ({count} profil(s) FFmpeg) : effectif au prochain programme." : "Volume identique désactivé.", Severity.Success);
    }

    private RenderFragment ChannelChips(List<int> ids) => __builder =>
    {
        <div class="d-flex gap-1 flex-wrap mt-2 align-center">
            <span class="n-muted" style="font-size: .85rem">Chaînes :</span>
            @foreach (ChannelViewModel channel in _channels)
            {
                bool on = ids.Contains(channel.Id);
                <MudChip T="int" Size="Size.Small" Color="@(on ? Color.Primary : Color.Default)" Variant="@(on ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => { if (!ids.Remove(channel.Id)) { ids.Add(channel.Id); } })">@channel.Number · @channel.Name</MudChip>
            }
        </div>
    };

    /// <summary>« Diffuser automatiquement » : heures, chaînes, juste avant le programme suivant.</summary>
    private RenderFragment BroadcastEditor(BroadcastSettings b) => __builder =>
    {
        <div class="n-broadcast mt-3" style="border-top: 1px solid var(--mud-palette-lines-default); padding-top: 10px">
            <MudSwitch T="bool" @bind-Value="b.Enabled" Color="Color.Secondary" Label="Diffuser automatiquement à l'antenne"/>
            @if (b.Enabled)
            {
                <MudTextField @bind-Value="b.Times" Label="Heures (séparées par des virgules)" Placeholder="07:00, 12:55, 19:55" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                @ChannelChips(b.ChannelIds)
                <MudSwitch T="bool" @bind-Value="b.BeforeNext" Color="Color.Primary"
                           Label="@(b.BeforeNext ? "Juste avant le programme suivant (remplace la fin du programme en cours)" : "À l'heure exacte (coupe le programme en cours)")"/>
            }
        </div>
    };

    // ------------------------------------------------ cette semaine, météo, interlude, rendez-vous

    private AtelierJob _weeklyJob;
    private AtelierJob _weatherJob;
    private AtelierJob _interludeJob;
    private List<WeatherRow> _weatherRows;
    private string _interludeLabel = "INTERLUDE";
    private string _interludeChannel = string.Empty;
    private string _interludeMusic = string.Empty;
    private double _interludeSeconds = 60;
    private readonly List<int> _interludeChannels = [];
    private List<RegieChannel> _regieChannels = [];
    private Appointment _newAppointment = new();
    private RegieSource _newSource;

    private async Task Busy(Func<Task> work)
    {
        _busy = true;
        try
        {
            await work();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Poll(Func<AtelierJob> job)
    {
        while (job() is { State: AtelierJobState.Running })
        {
            await Task.Delay(1000);
            await InvokeAsync(StateHasChanged);
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task MakeWeekly() => Busy(async () =>
    {
        Save();
        _weeklyJob = await Automation.MakeWeekly(CancellationToken.None);
        _s = NounoursSettings.Load();
        if (_weeklyJob is null)
        {
            Snackbar.Add(_s.Weekly.LastResult, Severity.Warning);
        }
        else
        {
            _ = Poll(() => _weeklyJob);
        }
    });

    private Task PreviewWeather() => Busy(async () => _weatherRows = await Automation.WeatherRows(_s.Weather, CancellationToken.None));

    private Task MakeWeather() => Busy(async () =>
    {
        Save();
        _weatherJob = await Automation.MakeWeather(CancellationToken.None);
        _s = NounoursSettings.Load();
        _ = Poll(() => _weatherJob);
    });

    private AtelierJob _essentialJob;

    private Task MakeEssential() => Busy(async () =>
    {
        Save();
        _essentialJob = await Automation.MakeEssential(CancellationToken.None);
        _s = NounoursSettings.Load();
        if (_essentialJob is null)
        {
            Snackbar.Add(_s.Essential.LastResult, Severity.Warning);
            return;
        }

        _ = Poll(() => _essentialJob);
    });

    private void MakeInterlude()
    {
        _interludeJob = Atelier.StartInterlude(_interludeLabel, _interludeChannel, _interludeMusic, _interludeSeconds, new AtelierStyle());
        _ = Poll(() => _interludeJob);
    }

    private Task UseInterlude() => Busy(async () =>
    {
        string result = await Automation.UseInterlude(_interludeChannels, CancellationToken.None);
        Snackbar.Add(result, Severity.Success);
    });

    private async Task<IEnumerable<RegieSource>> SearchSources(string text, CancellationToken token) =>
        string.IsNullOrWhiteSpace(text) ? await Regie.Suggestions(token) : await Regie.Search(text, token);

    private void AddAppointment()
    {
        _newAppointment.MediaItemId = _newSource.MediaItemId;
        _newAppointment.MediaTitle = _newSource.Title;
        _s.Appointments.Add(_newAppointment);
        _newAppointment = new Appointment { Name = "Fermeture d'antenne", At = "23:59" };
        _newSource = null;
        Save();
    }

    private void AddEphemeral()
    {
        _s.EphemeralChannels[_ephemeralChannel] = new DateTimeOffset(_ephemeralDate!.Value.Date.AddDays(1).AddSeconds(-1));
        Save();
    }
}
