    private static RenderFragment FramePreview(HabillageItem item)
    {
        double l = Math.Clamp(item.FrameSide, 0, 45) * 16;
        double t = Math.Clamp(item.FrameTop, 0, 45) * 9;
        double b = Math.Clamp(item.FrameBottom, 0, 45) * 9;
        double r = Math.Max(0, item.CornerRadius) * 1600 / 1920;
        double w = 1600 - 2 * l;
        double h = 900 - t - b;
        string window = r > 0
            ? $"M{Num(l + r)},{Num(t)} h{Num(w - 2 * r)} a{Num(r)},{Num(r)} 0 0 1 {Num(r)},{Num(r)} v{Num(h - 2 * r)} a{Num(r)},{Num(r)} 0 0 1 -{Num(r)},{Num(r)} h-{Num(w - 2 * r)} a{Num(r)},{Num(r)} 0 0 1 -{Num(r)},-{Num(r)} v-{Num(h - 2 * r)} a{Num(r)},{Num(r)} 0 0 1 {Num(r)},-{Num(r)} Z"
            : $"M{Num(l)},{Num(t)} h{Num(w)} v{Num(h)} h-{Num(w)} Z";
        string shadow = item.FrameShadow
            ? $"<rect x=\"{Num(l)}\" y=\"{Num(t)}\" width=\"{Num(w)}\" height=\"{Num(h)}\" rx=\"{Num(r)}\" fill=\"none\" stroke=\"rgba(0,0,0,.35)\" stroke-width=\"3\" pointer-events=\"none\"/>"
            : string.Empty;
        string svg = $"<svg viewBox=\"0 0 1600 900\" preserveAspectRatio=\"none\"><path fill-rule=\"evenodd\" fill=\"{item.BackgroundColor}\" d=\"M0,0 H1600 V900 H0 Z {window}\"/>{shadow}</svg>";
        return builder => builder.AddMarkupContent(0, svg);
    }

    private static string TickerStyle(HabillageItem item) =>
        $"background: {item.BackgroundColor}; height: {Num(item.Height * 0.5625)}cqw; color: {item.Color}; "
        + $"font-family: '{item.FontFamily}', Roboto, sans-serif; font-weight: {item.FontWeight}; font-size: {Num(item.Height * 0.326)}cqw;"
        + (item.Italic ? " font-style: italic;" : string.Empty);

    private static string TickerPreview(HabillageItem item)
    {
        var parts = (item.TickerMessages ?? string.Empty).Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (!string.IsNullOrWhiteSpace(item.WeatherCity))
        {
            parts.Add($"Météo {item.WeatherCity} : 14 °C, éclaircies");
        }

        if (!string.IsNullOrWhiteSpace(item.RssUrl))
        {
            parts.Add("Titres du flux RSS…");
        }

        return string.Join("  •  ", parts.DefaultIfEmpty("…"));
    }

    private async Task FindCity(HabillageItem item)
    {
        try
        {
            var found = await ErsatzTV.Application.Nounours.HabillageService.FindCity(item.WeatherCity, CancellationToken.None);
            if (found is null)
            {
                Snackbar.Add("Ville introuvable.", Severity.Warning);
                return;
            }

            item.WeatherCity = found.Value.Name;
            item.WeatherLatitude = found.Value.Latitude;
            item.WeatherLongitude = found.Value.Longitude;
            MarkDirty();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Recherche impossible : {ex.Message}", Severity.Error);
        }
    }

    private static string BannerStyle(HabillageItem item) =>
        $"background: {item.BackgroundColor}; border-radius: {Num(item.CornerRadius * 100 / 1920)}cqw; aspect-ratio: {Num(Math.Max(0.01, item.Width * 16))} / {Num(Math.Max(0.01, item.Height * 9))}; width: 100%";

    private static string PreviewText(HabillageItem item)
    {
        if (item.Kind == HabillageItemKind.Clock)
        {
            string clock;
            try
            {
                TimeZoneInfo tz = string.IsNullOrWhiteSpace(item.TimeZone)
                    ? TimeZoneInfo.Local
                    : TimeZoneConverter.TZConvert.GetTimeZoneInfo(item.TimeZone);
                clock = TimeZoneInfo.ConvertTime(DateTimeOffset.Now, tz).ToString(string.IsNullOrWhiteSpace(item.Format) ? "HH:mm" : item.Format, Fr);
            }
            catch (Exception ex) when (ex is FormatException or TimeZoneNotFoundException)
            {
                clock = "format ?";
            }

            return string.IsNullOrWhiteSpace(item.Text)
                ? clock
                : item.Text.Replace("{clock}", clock, StringComparison.Ordinal)
                    .Replace("{countdown}", "1:30", StringComparison.Ordinal)
                    .Replace("{restant}", "12:05", StringComparison.Ordinal);
        }

        string text = item.Text ?? string.Empty;
        text = Regex.Replace(text, @"\{\{\s*(if|end|else)[^}]*\}\}", string.Empty);
        text = Regex.Replace(text, @"\{\{([^}]*)\}\}", m => Sample(m.Groups[1].Value));
        return string.IsNullOrWhiteSpace(text) ? "(texte vide)" : text;
    }

    private static string Sample(string expression) =>
        expression switch
        {
            _ when expression.Contains("format_datetime", StringComparison.Ordinal) => "21:00",
            _ when expression.Contains("Epg", StringComparison.Ordinal) => "Le Journal",
            _ when expression.Contains("ShowTitle", StringComparison.Ordinal) => "Nom de la série",
            _ when expression.Contains("ShowYear", StringComparison.Ordinal) || expression.Contains("ReleaseDate", StringComparison.Ordinal) => "2024",
            _ when expression.Contains("ContentRating", StringComparison.Ordinal) => "-12",
            _ when expression.Contains("Title", StringComparison.Ordinal) => "Titre du programme",
            _ => "…"
        };

    private static string ImageUrl(string path) =>
        path.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? path
            : $"nounours/habillage/asset?path={Uri.EscapeDataString(path)}";

    private Task<IEnumerable<string>> SearchFonts(string text, CancellationToken token)
    {
        IEnumerable<string> families = _fonts.Select(f => f.Family).Concat(["Roboto", "Arial", "Segoe UI"]).Distinct();
        return Task.FromResult(string.IsNullOrWhiteSpace(text) ? families : families.Where(f => f.Contains(text, StringComparison.OrdinalIgnoreCase)));
    }

