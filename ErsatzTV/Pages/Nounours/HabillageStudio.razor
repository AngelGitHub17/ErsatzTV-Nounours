    private static string LayerStyle(HabillageItem item)
    {
        var css = $"left: {Num(item.X)}%; top: {Num(item.Y)}%; z-index: {item.ZIndex}; opacity: {Num(Math.Clamp(item.Opacity, 0, 100) / 100.0)};";
        if (item.Kind is HabillageItemKind.Frame or HabillageItemKind.Curtain)
        {
            return $"left: 0; top: 0; width: 100%; height: 100%; z-index: {item.ZIndex}; opacity: {Num(Math.Clamp(item.Opacity, 0, 100) / 100.0)};";
        }

        if (item.Kind is HabillageItemKind.Image or HabillageItemKind.Banner or HabillageItemKind.Ticker or HabillageItemKind.Rating or HabillageItemKind.UpNext || item.Kind == HabillageItemKind.Clock && item.Analog)
        {
            css += $" width: {Num(item.Width)}%;";
        }
        else if (item.Width > 0)
        {
            css += $" max-width: {Num(item.Width)}%; overflow: hidden;";
        }

        return css;
    }

    private static string TextStyle(HabillageItem item)
    {
        // 1 px en 1080p = 100/1080 % de la hauteur = 56.25/1080 cqw (largeur de la scène)
        string px(double value) => $"{Num(value * 56.25 / 1080)}cqw";
        var css = $"font-family: '{item.FontFamily}', Roboto, sans-serif; font-size: {px(item.FontSize)}; font-weight: {item.FontWeight}; color: {item.Color}; text-align: {item.Align.ToLowerInvariant()};";
        if (item.Italic)
        {
            css += " font-style: italic;";
        }

        if (item.HaloWidth > 0)
        {
            css += $" -webkit-text-stroke: {px(item.HaloWidth * 2)} {item.HaloColor}; paint-order: stroke fill;";
        }

        return css;
    }

    // aperçu de l'horloge à aiguilles (même dessin que le moteur, en SVG)
    private static RenderFragment AnalogPreview(HabillageItem item)
    {
        DateTime now = DateTime.Now;
        try
        {
            if (!string.IsNullOrWhiteSpace(item.TimeZone))
            {
                now = TimeZoneInfo.ConvertTime(DateTimeOffset.Now, TimeZoneConverter.TZConvert.GetTimeZoneInfo(item.TimeZone)).DateTime;
            }
        }
        catch (TimeZoneNotFoundException)
        {
            // fuseau inconnu : heure locale
        }

        const double size = 100;
        double outline = Math.Clamp(item.AnalogOutline, 0, 20);
        double shadow = item.HaloWidth > 0 ? 2.5 : 0;
        double radius = size / 2 - outline / 2 - shadow - 1;
        double inner = radius - outline / 2;
        double minutes = now.Minute + now.Second / 60.0;
        double hours = now.Hour % 12 + minutes / 60.0;
        string stroke = item.Color;
        string shadowColor = item.HaloColor;

        (double, double) At(double degrees, double length) =>
            (50 + Math.Sin(degrees * Math.PI / 180) * length, 50 - Math.Cos(degrees * Math.PI / 180) * length);

        var sb = new System.Text.StringBuilder();
        sb.Append(CultureInfo.InvariantCulture, $"<svg class=\"n-analog\" viewBox=\"0 0 100 100\"><circle cx=\"50\" cy=\"50\" r=\"{Num(radius)}\" fill=\"{item.FaceColor}\"/>");

        void Line(double x1, double y1, double x2, double y2, double width, string color)
        {
            if (shadow > 0)
            {
                sb.Append(CultureInfo.InvariantCulture, $"<line x1=\"{Num(x1)}\" y1=\"{Num(y1)}\" x2=\"{Num(x2)}\" y2=\"{Num(y2)}\" stroke=\"{shadowColor}\" stroke-opacity=\".6\" stroke-width=\"{Num(width + shadow * 2)}\" stroke-linecap=\"round\"/>");
            }

            sb.Append(CultureInfo.InvariantCulture, $"<line x1=\"{Num(x1)}\" y1=\"{Num(y1)}\" x2=\"{Num(x2)}\" y2=\"{Num(y2)}\" stroke=\"{color}\" stroke-width=\"{Num(width)}\" stroke-linecap=\"round\"/>");
        }

        void Dot(double x, double y, double r)
        {
            if (shadow > 0)
            {
                sb.Append(CultureInfo.InvariantCulture, $"<circle cx=\"{Num(x)}\" cy=\"{Num(y)}\" r=\"{Num(r + shadow)}\" fill=\"{shadowColor}\" fill-opacity=\".6\"/>");
            }

            sb.Append(CultureInfo.InvariantCulture, $"<circle cx=\"{Num(x)}\" cy=\"{Num(y)}\" r=\"{Num(r)}\" fill=\"{stroke}\"/>");
        }

        if (outline > 0)
        {
            if (shadow > 0)
            {
                sb.Append(CultureInfo.InvariantCulture, $"<circle cx=\"50\" cy=\"50\" r=\"{Num(radius)}\" fill=\"none\" stroke=\"{shadowColor}\" stroke-opacity=\".6\" stroke-width=\"{Num(outline + shadow * 2)}\"/>");
            }

            sb.Append(CultureInfo.InvariantCulture, $"<circle cx=\"50\" cy=\"50\" r=\"{Num(radius)}\" fill=\"none\" stroke=\"{stroke}\" stroke-width=\"{Num(outline)}\"/>");
        }

        for (var i = 0; i < 12; i++)
        {
            bool major = i % 3 == 0;
            if (item.AnalogTicks == "dots")
            {
                (double x, double y) = At(i * 30, inner - 9);
                Dot(x, y, major ? 3.2 : 2.2);
            }
            else if (item.AnalogTicks == "lines")
            {
                (double x1, double y1) = At(i * 30, inner - (major ? 16 : 11));
                (double x2, double y2) = At(i * 30, inner - 5);
                Line(x1, y1, x2, y2, major ? 4 : 2.2, stroke);
            }
        }

        (double hx, double hy) = At(hours * 30, inner * 0.5);
        Line(50, 50, hx, hy, 7.5, stroke);
        (double mx, double my) = At(minutes * 6, inner * 0.78);
        Line(50, 50, mx, my, 5.5, stroke);
        if (item.AnalogSeconds)
        {
            (double sx, double sy) = At(now.Second * 6, inner * 0.82);
            Line(50, 50, sx, sy, 2.2, item.SecondsColor);
        }

        Dot(50, 50, 4.5);
        sb.Append("</svg>");
        string svg = sb.ToString();
        return builder => builder.AddMarkupContent(0, svg);
    }

