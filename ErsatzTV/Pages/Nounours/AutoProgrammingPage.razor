@page "/programmation-auto"
@using System.Globalization
@using ErsatzTV.Application.Channels
@using ErsatzTV.Nounours
@inject AutoProgrammingService Auto
@inject IMediator Mediator
@inject ISnackbar Snackbar

<PageTitle>Programmation automatique · ErsatzTV</PageTitle>

<div class="n-page" style="height: 100%; overflow-y: auto">
    <div class="n-page-header">
        <div>
            <h1>Programmation automatique</h1>
            <p>ErsatzTV regarde votre médiathèque et propose une vraie grille de télé : matinale jeunesse, séries, film de l'après-midi, film du soir à 20h45, nuit en rediffusion, et un week-end différent. Ajustez si vous voulez, puis appliquez : c'est prêt.</p>
        </div>
    </div>

    <div class="n-auto">
        <div class="d-flex flex-column gap-3">
            <div class="n-card">
                <div class="n-card-title">1. Pour quelle chaîne ?</div>
                <MudToggleGroup T="bool" @bind-Value="_newChannel" Outlined="true" Size="Size.Small" Color="Color.Primary">
                    <MudToggleItem Value="true" Text="Nouvelle chaîne"/>
                    <MudToggleItem Value="false" Text="Une chaîne existante"/>
                </MudToggleGroup>
                @if (_newChannel)
                {
                    <div class="d-flex gap-2 mt-3">
                        <MudTextField @bind-Value="_name" Label="Nom" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                        <MudTextField @bind-Value="_number" Label="Numéro (facultatif)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 150px"/>
                    </div>
                }
                else
                {
                    <MudSelect T="int" @bind-Value="_channelId" Label="Chaîne" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3">
                        @foreach (ChannelViewModel channel in _channels)
                        {
                            <MudSelectItem Value="@channel.Id">@channel.Number · @channel.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Typo="Typo.caption" Class="n-muted">Sa programmation actuelle sera remplacée (les vidéos ne sont pas touchées).</MudText>
                }
            </div>

            <div class="n-card">
                <div class="n-card-title">2. Le style</div>
                <div class="n-templates" style="grid-template-columns: repeat(auto-fill, minmax(190px, 1fr))">
                    @foreach (AutoStyle style in AutoProgrammingService.Styles)
                    {
                        <div class="n-card n-style @(_plan?.Style == style.Key ? "is-active" : "")" style="padding: 12px; cursor: pointer" @onclick="@(() => Propose(style.Key))">
                            <b>@style.Name</b>
                            <div class="n-muted" style="font-size: .82rem">@style.Description</div>
                        </div>
                    }
                </div>
            </div>

            <div class="n-card">
                <div class="n-card-title">3. Les options</div>
                @if (_plan is not null)
                {
                    <MudSwitch T="bool" @bind-Value="_plan.Jingles" Color="Color.Primary" Label="Un jingle avant chaque programme (vos « Jingles »)"/>
                    <MudSwitch T="bool" @bind-Value="_plan.Pubs" Color="Color.Primary" Label="Des pubs entre les programmes (vos « Pubs »)"/>
                    @if (_plan.Pubs)
                    {
                        <MudSwitch T="bool" @bind-Value="_plan.QuarterHour" Color="Color.Primary" Label="Les programmes commencent au quart d'heure (les pubs comblent)"/>
                    }
                    <MudSwitch T="bool" @bind-Value="_plan.WeekendDifferent" Color="Color.Primary" Label="Un week-end différent (samedi et dimanche)"/>
                }
            </div>

            <div class="n-card">
                <div class="n-card-title">Votre médiathèque</div>
                @if (_library is null)
                {
                    <MudProgressLinear Indeterminate="true"/>
                }
                else
                {
                    @foreach (CategoryInfo info in _library.Values)
                    {
                        <div class="d-flex align-center gap-2" style="font-size: .9rem; padding: 2px 0">
                            <span class="n-auto-dot" style="background: @Tint(info.Category)"></span>
                            <span style="flex: 1">@info.Name</span>
                            <b>@info.Count</b>
                            @if (info.Fallback)
                            {
                                <MudTooltip Text="Rien de ce genre trouvé : un autre type de programme le remplace">
                                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Color="Color.Warning"/>
                                </MudTooltip>
                            }
                        </div>
                    }
                    <MudText Typo="Typo.caption" Class="n-muted d-block mt-1">Reconnu grâce aux genres et classifications de vos films et séries (Animation, Famille, Documentaire…).</MudText>
                }
            </div>
        </div>

        <div class="d-flex flex-column gap-3">
            @if (_plan is not null)
            {
                <div class="n-card">
                    <div class="d-flex align-center justify-space-between">
                        <div class="n-card-title" style="margin: 0">4. La grille</div>
                        <MudToggleGroup T="bool" @bind-Value="_weekend" Outlined="true" Size="Size.Small" Color="Color.Primary">
                            <MudToggleItem Value="false" Text="Lundi → vendredi"/>
                            <MudToggleItem Value="true" Text="Week-end" Disabled="@(!_plan.WeekendDifferent)"/>
                        </MudToggleGroup>
                    </div>

                    @* frise de la journée, de 5h à 5h *@
                    <div class="n-auto-day mt-3">
                        @foreach ((AutoBlock block, double left, double width) in Spans(Blocks))
                        {
                            <div style="left: @Pct(left); width: @Pct(width); background: @Tint(block.Category)" title="@($"{AutoProgrammingService.Hour(block.Start)} · {Title(block)}")">
                                <span>@(width > 0.07 ? Title(block) : "")</span>
                            </div>
                        }
                    </div>
                    <div class="d-flex justify-space-between n-muted" style="font-size: .72rem">
                        @foreach (int h in new[] { 5, 8, 11, 14, 17, 20, 23, 2, 5 })
                        {
                            <span>@($"{h:00}h")</span>
                        }
                    </div>

                    <div class="mt-3">
                        @foreach (AutoBlock block in Blocks.OrderBy(b => Sort(b.Start)).ToList())
                        {
                            <div class="n-auto-row" @key="block">
                                <span class="n-auto-dot" style="background: @Tint(block.Category)"></span>
                                <MudTextField T="string" Value="@AutoProgrammingService.Hour(block.Start)" ValueChanged="@(v => SetHour(block, v))" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 90px; flex: none" Mask="@(new PatternMask("00:00"))"/>
                                <MudSelect T="AutoCategory" @bind-Value="block.Category" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 210px; flex: none">
                                    @foreach (AutoCategory category in Enum.GetValues<AutoCategory>())
                                    {
                                        <MudSelectItem Value="@category">@AutoProgrammingService.CategoryName(category)</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField @bind-Value="block.Label" Placeholder="Nom du rendez-vous (guide)" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                <MudTooltip Text="@(block.One ? "Un seul programme (ex. le film du soir)" : "En continu jusqu'au rendez-vous suivant")">
                                    <MudToggleIconButton @bind-Toggled="block.One" Icon="@Icons.Material.Filled.AllInclusive" ToggledIcon="@Icons.Material.Filled.LooksOne" ToggledColor="Color.Primary"/>
                                </MudTooltip>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => Blocks.Remove(block))"/>
                            </div>
                        }
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="@AddBlock" Size="Size.Small">Ajouter un rendez-vous</MudButton>
                    </div>
                    <MudText Typo="Typo.caption" Class="n-muted d-block">∞ = en continu jusqu'au rendez-vous suivant · 1 = un seul programme. Un film qui déborde décale le rendez-vous suivant.</MudText>
                </div>

                <div class="n-card">
                    <div class="d-flex gap-2 align-center flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.AutoMode" OnClick="@Apply"
                                   Disabled="@(_busy || (!_newChannel && _channelId == 0) || (_newChannel && string.IsNullOrWhiteSpace(_name)))">
                            @(_newChannel ? "Créer la chaîne avec cette grille" : "Remplacer la programmation")
                        </MudButton>
                        @if (_busy)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small"/>
                        }
                    </div>
                    @foreach (string step in _steps)
                    {
                        <div style="font-size: .9rem" class="mt-1">✓ @step</div>
                    }
                    @if (_done)
                    {
                        <MudButton Href="planning" Variant="Variant.Outlined" Class="mt-2" StartIcon="@Icons.Material.Filled.CalendarMonth">Voir le planning</MudButton>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool _newChannel = true;
    private string _name = "Nounours TV 2";
    private string _number = string.Empty;
    private int _channelId;
    private List<ChannelViewModel> _channels = [];
    private Dictionary<AutoCategory, CategoryInfo> _library;
    private AutoPlan _plan;
    private bool _weekend;
    private bool _busy;
    private bool _done;
    private readonly List<string> _steps = [];

    private List<AutoBlock> Blocks => _weekend && _plan.WeekendDifferent ? _plan.Weekend : _plan.Week;

    protected override async Task OnInitializedAsync()
    {
        _channels = (await Mediator.Send(new GetAllChannels()))
            .OrderBy(c => double.TryParse(c.Number, NumberStyles.Number, CultureInfo.InvariantCulture, out double n) ? n : 0)
            .ToList();
        _channelId = _channels.FirstOrDefault()?.Id ?? 0;
        _library = await Auto.Analyze(CancellationToken.None);
        Propose("generaliste");
    }

    private void Propose(string style)
    {
        AutoPlan previous = _plan;
        _plan = AutoProgrammingService.Propose(style, _library);
        if (previous is not null)
        {
            (_plan.Jingles, _plan.Pubs, _plan.QuarterHour, _plan.WeekendDifferent) = (previous.Jingles, previous.Pubs, previous.QuarterHour, previous.WeekendDifferent);
        }
    }

    private static double Sort(TimeSpan t) => (t - TimeSpan.FromHours(5)).TotalHours is var h && h < 0 ? h + 24 : (t - TimeSpan.FromHours(5)).TotalHours;

    /// <summary>Position des blocs sur la frise 5h → 5h (fraction de journée).</summary>
    private static IEnumerable<(AutoBlock, double, double)> Spans(List<AutoBlock> blocks)
    {
        var ordered = blocks.OrderBy(b => Sort(b.Start)).ToList();
        for (var i = 0; i < ordered.Count; i++)
        {
            double start = Sort(ordered[i].Start) / 24;
            double end = i + 1 < ordered.Count ? Sort(ordered[i + 1].Start) / 24 : 1;
            yield return (ordered[i], start, Math.Max(0.004, end - start));
        }
    }

    private static string Pct(double value) => (value * 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";

    private static string Title(AutoBlock block) => string.IsNullOrWhiteSpace(block.Label) ? AutoProgrammingService.CategoryName(block.Category) : block.Label;

    private static string Tint(AutoCategory category) =>
        category switch
        {
            AutoCategory.Jeunesse => "#FFA800",
            AutoCategory.Series => "#0B2B70",
            AutoCategory.Film => "#8C0A11",
            AutoCategory.FilmFamille => "#FF3200",
            AutoCategory.Documentaires => "#008A22",
            AutoCategory.Clips => "#B04FC0",
            AutoCategory.Info => "#3C3632",
            _ => "#555B66"
        };

    private static void SetHour(AutoBlock block, string value)
    {
        if (TimeSpan.TryParseExact(value, @"hh\:mm", CultureInfo.InvariantCulture, out TimeSpan t) && t < TimeSpan.FromDays(1))
        {
            block.Start = t;
        }
    }

    private void AddBlock()
    {
        TimeSpan last = Blocks.Count == 0 ? new TimeSpan(20, 0, 0) : Blocks.Max(b => b.Start);
        Blocks.Add(new AutoBlock { Start = TimeSpan.FromTicks(last.Add(TimeSpan.FromHours(1)).Ticks % TimeSpan.TicksPerDay), Category = AutoCategory.Series });
    }

    private async Task Apply()
    {
        _busy = true;
        _done = false;
        _steps.Clear();
        try
        {
            Either<BaseError, List<string>> result = await Auto.Apply(
                _plan, _newChannel ? null : _channelId, _name, _number,
                new Progress<string>(m => InvokeAsync(StateHasChanged)), CancellationToken.None);
            result.Match(
                steps =>
                {
                    _steps.AddRange(steps);
                    _done = true;
                    Snackbar.Add("Programmation appliquée.", Severity.Success);
                },
                error => Snackbar.Add(error.ToString(), Severity.Error));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"La programmation n'a pas pu être appliquée : {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
