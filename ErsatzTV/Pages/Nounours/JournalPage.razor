@page "/journal"
@using System.Globalization
@using ErsatzTV.Application.Nounours
@inject IJournalService Journal

<PageTitle>Journal de diffusion · ErsatzTV</PageTitle>

<div class="n-page" style="height: 100%; overflow-y: auto">
    <div class="n-page-header">
        <div>
            <h1>Journal de diffusion</h1>
            <p>Tout ce qui est passé à l'antenne, à la seconde : programmes, jingles, pubs, prises d'antenne de la régie et directs. Noté automatiquement chaque minute.</p>
        </div>
        @if (_lines.Count > 0)
        {
            <a class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-filled-size-medium" style="padding: 6px 16px"
               href="@CsvLink()" download="@($"journal-{_day:yyyy-MM-dd}.csv")">Télécharger (CSV)</a>
        }
    </div>

    <MudToggleGroup T="bool" @bind-Value="_stats" Outlined="true" Size="Size.Small" Color="Color.Primary" Class="mb-3">
        <MudToggleItem Value="false" Text="Journal du jour"/>
        <MudToggleItem Value="true" Text="Statistiques de la semaine"/>
    </MudToggleGroup>

    @if (_stats)
    {
        JournalStats stats = WeekStats();
        <div class="n-card mb-3">
            <div class="n-card-title">Du @_day.AddDays(-6).ToString("d MMMM", Fr) au @_day.ToString("d MMMM", Fr) · @Length(stats.Total) d'antenne notées</div>
            <div class="n-stat-bar">
                @foreach (JournalTotal kind in stats.Kinds)
                {
                    <div style="flex: @Share(kind.Time, stats.Total); background: @KindColor(kind.Name)" title="@($"{kind.Name} · {Length(kind.Time)}")"></div>
                }
            </div>
            <div class="d-flex gap-3 flex-wrap mt-2" style="font-size: .85rem">
                @foreach (JournalTotal kind in stats.Kinds)
                {
                    <span><span class="n-auto-dot" style="background: @KindColor(kind.Name)"></span> @kind.Name · <b>@Pct(kind.Time, stats.Total)</b> (@Length(kind.Time))</span>
                }
            </div>
        </div>

        <MudGrid Spacing="3">
            <MudItem xs="12" lg="6">
                <div class="n-card" style="height: 100%">
                    <div class="n-card-title">Par chaîne</div>
                    @foreach ((string channel, TimeSpan total, List<JournalTotal> kinds) in stats.Channels)
                    {
                        <div class="mt-2" style="font-size: .9rem"><b>@channel</b> <span class="n-muted">· @Length(total)</span></div>
                        <div class="n-stat-bar" style="height: 14px">
                            @foreach (JournalTotal kind in kinds)
                            {
                                <div style="flex: @Share(kind.Time, total); background: @KindColor(kind.Name)" title="@($"{kind.Name} · {Length(kind.Time)}")"></div>
                            }
                        </div>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" lg="6">
                <div class="n-card" style="height: 100%">
                    <div class="n-card-title">Les programmes les plus diffusés</div>
                    @{ TimeSpan top = stats.Programmes.Count == 0 ? TimeSpan.FromSeconds(1) : stats.Programmes[0].Time; }
                    @foreach (JournalTotal programme in stats.Programmes)
                    {
                        <div class="n-stat-row">
                            <span class="n-stat-name">@programme.Name</span>
                            <span class="n-stat-track"><span style="width: @Pct(programme.Time, top)"></span></span>
                            <span class="n-muted" style="width: 120px; text-align: right">@Length(programme.Time) · @(programme.Count)×</span>
                        </div>
                    }
                    @if (stats.Repeats.Count > 0)
                    {
                        <div class="n-card-title mt-4">Ce qui repasse le plus</div>
                        <MudText Typo="Typo.caption" Class="n-muted d-block mb-1">Le même épisode ou film plusieurs fois par jour en moyenne : de quoi élargir la collection ou passer en « mélange ».</MudText>
                        @foreach (JournalTotal repeat in stats.Repeats)
                        {
                            <div class="n-stat-row"><span class="n-stat-name">@repeat.Name</span><b>@(repeat.Count)×</b></div>
                        }
                    }
                </div>
            </MudItem>
        </MudGrid>
    }
    else
    {
    <div class="n-card mb-3">
        <div class="d-flex gap-3 flex-wrap align-center">
            <MudSelect T="DateOnly" Value="@_day" ValueChanged="@SelectDay" Label="Jour" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 220px">
                @foreach (DateOnly day in _days)
                {
                    <MudSelectItem Value="@day">@day.ToString("dddd d MMMM yyyy", Fr)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_channel" Label="Chaîne" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 240px">
                <MudSelectItem Value="@string.Empty">Toutes</MudSelectItem>
                @foreach (string channel in _all.Select(l => l.Channel).Distinct().Order())
                {
                    <MudSelectItem Value="@channel">@channel</MudSelectItem>
                }
            </MudSelect>
            <MudSwitch T="bool" @bind-Value="_hideFiller" Color="Color.Primary" Label="Masquer les intercalaires"/>
            <span class="n-muted">@_lines.Count élément(s)</span>
        </div>
    </div>

    <div class="n-card">
        @if (_lines.Count == 0)
        {
            <div class="n-empty" style="padding: 24px">Rien de noté pour ce jour. Le journal commence quand ErsatzTV tourne.</div>
        }
        @foreach (JournalLine line in _lines)
        {
            <div class="n-cond-row @(line.Kind == "Intercalaire" ? "is-filler" : "")">
                <b>@line.Start.ToString("HH:mm:ss", Fr)</b>
                <span class="n-muted" style="width: 150px; flex: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">@line.Channel</span>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(line.Kind == "Direct" ? Color.Error : Color.Default)">@line.Kind</MudChip>
                <span style="flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">@line.Title</span>
                <span class="n-muted">@Length(line.Finish - line.Start)</span>
            </div>
        }
    </div>
    }
</div>

@code {
    private static readonly CultureInfo Fr = CultureInfo.GetCultureInfo("fr-FR");
    private List<DateOnly> _days = [];
    private DateOnly _day = DateOnly.FromDateTime(DateTime.Today);
    private List<JournalLine> _all = [];
    private string _channel = string.Empty;
    private bool _hideFiller;
    private bool _stats;

    private JournalStats WeekStats()
    {
        var lines = new List<JournalLine>();
        for (var i = 0; i < 7; i++)
        {
            lines.AddRange(Journal.Read(_day.AddDays(-i)));
        }

        int days = Enumerable.Range(0, 7).Count(i => _days.Contains(_day.AddDays(-i)));
        return JournalStats.From(lines, Math.Max(1, days));
    }

    private static string Share(TimeSpan part, TimeSpan total) =>
        (total.TotalSeconds <= 0 ? 0 : part.TotalSeconds / total.TotalSeconds).ToString("0.####", CultureInfo.InvariantCulture);

    private static string Pct(TimeSpan part, TimeSpan total) =>
        (total.TotalSeconds <= 0 ? 0 : Math.Min(100, part.TotalSeconds * 100 / total.TotalSeconds)).ToString("0", CultureInfo.InvariantCulture) + "%";

    private static string KindColor(string kind) =>
        kind switch
        {
            "Film" => "#8C0A11",
            "Épisode" => "#0B2B70",
            "Clip" => "#B04FC0",
            "Direct" => "#FF3200",
            "Intercalaire" => "#555B66",
            _ => "#008A22"
        };

    private List<JournalLine> _lines =>
        _all.Where(l => (_channel.Length == 0 || l.Channel == _channel) && (!_hideFiller || l.Kind != "Intercalaire")).ToList();

    protected override void OnInitialized()
    {
        _days = Journal.Days();
        if (!_days.Contains(_day))
        {
            _days.Insert(0, _day);
        }

        _all = Journal.Read(_day);
    }

    private void SelectDay(DateOnly day)
    {
        _day = day;
        _all = Journal.Read(day);
    }

    private string CsvLink() =>
        "data:text/csv;charset=utf-8;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(Journal.Csv(_lines))).ToArray());

    private static string Length(TimeSpan t) =>
        t.TotalHours >= 1 ? $"{(int)t.TotalHours} h {t.Minutes:00}" : t.TotalMinutes >= 1 ? $"{(int)t.TotalMinutes} min {t.Seconds:00}" : $"{Math.Max(0, t.Seconds)} s";
}
