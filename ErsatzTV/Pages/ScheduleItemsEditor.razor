@page "/schedules/{Id:int}/items"
@using ErsatzTV.Application.Filler
@using ErsatzTV.Application.Graphics
@using ErsatzTV.Application.MediaCollections
@using ErsatzTV.Application.MediaItems
@using ErsatzTV.Application.ProgramSchedules
@using ErsatzTV.Application.Search
@using ErsatzTV.Application.Watermarks
@using ErsatzTV.Core.Domain.Filler
@using ErsatzTV.Core.Scheduling
@implements IDisposable
@inject NavigationManager NavigationManager
@inject ILogger<ScheduleItemsEditor> Logger
@inject ISnackbar Snackbar
@inject IMediator Mediator

<MudForm @ref="_form" @bind-IsValid="@_success" Style="max-height: 100%">
<MudPaper Square="true" Style="display: flex; height: 64px; min-height: 64px; width: 100%; z-index: 100; align-items: center">
    <div style="display: flex; flex-direction: row; margin-bottom: auto; margin-top: auto; width: 100%; align-items: center" class="ml-6 mr-6">
        <div class="flex-grow-1">
            @if (_selectedItem is not null)
            {
                string start = _selectedItem.StartType == StartType.Fixed ? _selectedItem.StartTime == null ? string.Empty : DateTime.Today.Add(_selectedItem.StartTime.Value).ToShortTimeString() : "Dynamique";
                var mode = ErsatzTV.Nounours.Fr.Label(_selectedItem.PlayoutMode);
                @if (_selectedItem.PlayoutMode is PlayoutMode.Multiple)
                {
                    switch (_selectedItem.MultipleMode)
                    {
                        case MultipleMode.CollectionSize:
                            mode = "Taille de la collection";
                            break;
                        case MultipleMode.PlaylistItemSize:
                            mode = "Taille de l'élément";
                            break;
                        case MultipleMode.MultiEpisodeGroupSize:
                            mode = "Taille des groupes d'épisodes";
                            break;
                        case MultipleMode.Count:
                        default:
                            mode += $" ({_selectedItem.MultipleCount})";
                            break;
                    }
                }

                var result = $"{_schedule.Name} ({start} - {_selectedItem.CollectionName} - {mode})";
                <MudText>@result</MudText>
            }
            else
            {
                <MudText>@_schedule.Name</MudText>
            }
        </div>
        <div style="margin-left: auto" class="d-none d-md-flex">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveChanges" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_schedule?.Items is null)">
                Enregistrer les éléments du planning
            </MudButton>
            <MudButton Class="ml-3" Variant="Variant.Filled" Color="Color.Default" OnClick="@AddScheduleItem" StartIcon="@Icons.Material.Filled.PlaylistAdd" Disabled="@(_schedule?.Items is null)">
                Ajouter un élément au planning
            </MudButton>
        </div>
        <div style="align-items: center; display: flex; margin-left: auto;" class="d-md-none">
            <div class="flex-grow-1"></div>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                <MudMenuItem Icon="@Icons.Material.Filled.Save" Label="Enregistrer les éléments du planning" OnClick="@SaveChanges"/>
                <MudMenuItem Icon="@Icons.Material.Filled.PlaylistAdd" Label="Ajouter un élément au planning" OnClick="@AddScheduleItem"/>
            </MudMenu>
        </div>
    </div>
</MudPaper>
<div class="d-flex flex-column" style="height: 100vh; overflow-x: auto">
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8">
<MudText Typo="Typo.h5" Class="mb-2">Éléments du planning</MudText>
<MudDivider Class="mb-6"/>
<MudTable T="ProgramScheduleItemEditViewModel"
          Hover="true"
          Items="_schedule?.Items?.OrderBy(i => i.Index)"
          Dense="true"
          SelectedItemChanged="@(vm => SelectedItemChanged(vm))"
          RowClassFunc="@SelectedRowClassFunc">
    <ColGroup>
        <MudHidden Breakpoint="Breakpoint.Xs">
            <col/>
            <col/>
            <col/>
            <col style="width: 240px;"/>
        </MudHidden>
    </ColGroup>
    <HeaderContent>
        <MudTh>Heure de début</MudTh>
        <MudTh>Collection</MudTh>
        <MudTh>Mode de diffusion</MudTh>
        <MudTh/>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Heure de début">
            <MudText Typo="@Typo.body2">
                @(context.StartType == StartType.Fixed ? context.StartTime == null ? string.Empty : DateTime.Today.Add(context.StartTime.Value).ToShortTimeString() : "Dynamique")
            </MudText>
        </MudTd>
        <MudTd DataLabel="Collection">
            <MudText Typo="@Typo.body2">
                @context.CollectionName
            </MudText>
        </MudTd>
        <MudTd DataLabel="Mode de diffusion">
            <MudText Typo="@Typo.body2">
                @if (context.PlayoutMode is PlayoutMode.Multiple)
                {
                    switch (context.MultipleMode)
                    {
                        case MultipleMode.CollectionSize:
                            @:Collection Size
                            break;
                        case MultipleMode.PlaylistItemSize:
                            @:Playlist Item Size
                            break;
                        case MultipleMode.MultiEpisodeGroupSize:
                            @:Multi-Episode Group Size
                            break;
                        case MultipleMode.Count:
                        default:
                            @($"Plusieurs ({context.MultipleCount})")
                            break;
                    }
                }
                else
                {
                    @ErsatzTV.Nounours.Fr.Label(context.PlayoutMode)
                }
            </MudText>
        </MudTd>
        <MudTd>
            <div class="d-flex">
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                               OnClick="@(_ => CopyItem(context))">
                </MudIconButton>
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                               OnClick="@(_ => MoveItemUp(context))"
                               Disabled="@(_schedule.ShuffleScheduleItems || _schedule.Items.All(x => x.Index >= context.Index))">
                </MudIconButton>
                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                               OnClick="@(_ => MoveItemDown(context))"
                               Disabled="@(_schedule.ShuffleScheduleItems || _schedule.Items.All(x => x.Index <= context.Index))">
                </MudIconButton>
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               OnClick="@(_ => RemoveScheduleItem(context))">
                </MudIconButton>
            </div>
        </MudTd>
    </RowTemplate>
</MudTable>
@if (_selectedItem is not null)
{
    <MudText Typo="Typo.h5" Class="mt-10 mb-2">Élément du planning</MudText>
    <MudDivider Class="mb-6"/>
    <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
        <div class="d-flex">
            <MudText>Type de début</MudText>
        </div>
        <MudSelect @bind-Value="_selectedItem.StartType" For="@(() => _selectedItem.StartType)">
            <MudSelectItem Value="StartType.Dynamic">Dynamique</MudSelectItem>
            @if (!_schedule.ShuffleScheduleItems)
            {
                <MudSelectItem Value="StartType.Fixed">Fixe</MudSelectItem>
            }
        </MudSelect>
    </MudStack>
    <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
        <div class="d-flex">
            <MudText>Heure de début</MudText>
        </div>
        <MudTimePicker @bind-Time="@_selectedItem.StartTime"
                       For="@(() => _selectedItem.StartTime)"
                       Disabled="@(_selectedItem.StartType == StartType.Dynamic)"
                       Editable="true"/>
    </MudStack>
    <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
        <div class="d-flex">
            <MudText>Comportement à heure fixe</MudText>
        </div>
        <MudSelect @bind-Value="_selectedItem.FixedStartTimeBehavior" For="@(() => _selectedItem.FixedStartTimeBehavior)" Disabled="@(_selectedItem.StartType is not StartType.Fixed)">
            <MudSelectItem Value="@((FixedStartTimeBehavior?)null)">Hériter</MudSelectItem>
            <MudSelectItem T="FixedStartTimeBehavior?" Value="FixedStartTimeBehavior.Strict">Strict : toujours attendre l'heure exacte</MudSelectItem>
            <MudSelectItem T="FixedStartTimeBehavior?" Value="FixedStartTimeBehavior.Flexible">Souple : démarrer dès que possible après l'heure prévue</MudSelectItem>
        </MudSelect>
    </MudStack>
    <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
        <div class="d-flex">
            <MudText>Type de collection</MudText>
        </div>
        <MudSelect @bind-Value="_selectedItem.CollectionType" For="@(() => _selectedItem.CollectionType)">
            <MudSelectItem Value="CollectionType.Collection">Collection</MudSelectItem>
            <MudSelectItem Value="CollectionType.TelevisionShow">Série</MudSelectItem>
            <MudSelectItem Value="CollectionType.TelevisionSeason">Saison</MudSelectItem>
            <MudSelectItem Value="CollectionType.Artist">Artiste</MudSelectItem>
            <MudSelectItem Value="CollectionType.MultiCollection">Multi-collection</MudSelectItem>
            <MudSelectItem Value="CollectionType.SmartCollection">Collection intelligente</MudSelectItem>
            <MudSelectItem Value="CollectionType.SearchQuery">Recherche</MudSelectItem>
            <MudSelectItem Value="CollectionType.Playlist">Playlist</MudSelectItem>
            <MudSelectItem Value="CollectionType.RerunFirstRun">Rediffusion (première diffusion)</MudSelectItem>
            <MudSelectItem Value="CollectionType.RerunRerun">Rediffusion (redif.)</MudSelectItem>
        </MudSelect>
    </MudStack>
    @if (_selectedItem.CollectionType == CollectionType.Collection)
    {
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Collection</MudText>
            </div>
            <MudAutocomplete T="MediaCollectionViewModel"
                             @bind-Value="_selectedItem.Collection" SearchFunc="@SearchCollections"
                             ToStringFunc="@(c => c?.Name)" Placeholder="Tapez pour rechercher…">
                <MoreItemsTemplate>
                    <MudText Align="Align.Center" Class="px-4 py-1">
                        Seuls les 10 premiers éléments sont affichés
                    </MudText>
                </MoreItemsTemplate>
            </MudAutocomplete>
        </MudStack>
    }

    @if (_selectedItem.CollectionType == CollectionType.MultiCollection)
    {
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Multi-collection</MudText>
            </div>
            <MudAutocomplete T="MultiCollectionViewModel"
                             @bind-Value="_selectedItem.MultiCollection" SearchFunc="@SearchMultiCollections"
                             ToStringFunc="@(c => c?.Name)" Placeholder="Tapez pour rechercher…">
                <MoreItemsTemplate>
                    <MudText Align="Align.Center" Class="px-4 py-1">
                        Seuls les 10 premiers éléments sont affichés
                    </MudText>
                </MoreItemsTemplate>
            </MudAutocomplete>
        </MudStack>
    }

    @if (_selectedItem.CollectionType == CollectionType.SmartCollection)
    {
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Collection intelligente</MudText>
            </div>
            <MudAutocomplete T="SmartCollectionViewModel"
                             @bind-Value="_selectedItem.SmartCollection" SearchFunc="@SearchSmartCollections"
                             ToStringFunc="@(c => c?.Name)" Placeholder="Tapez pour rechercher…">
                <MoreItemsTemplate>
                    <MudText Align="Align.Center" Class="px-4 py-1">
                        Seuls les 10 premiers éléments sont affichés
                    </MudText>
                </MoreItemsTemplate>
            </MudAutocomplete>
        </MudStack>
    }

    @if (_selectedItem.CollectionType == CollectionType.TelevisionShow)
    {
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Série</MudText>
            </div>
            <MudAutocomplete T="NamedMediaItemViewModel"
                             @bind-Value="_selectedItem.MediaItem" SearchFunc="@SearchTelevisionShows"
                             ToStringFunc="@(c => c?.Name)" Placeholder="Tapez pour rechercher…">
                <MoreItemsTemplate>
                    <MudText Align="Align.Center" Class="px-4 py-1">
                        Seuls les 10 premiers éléments sont affichés
                    </MudText>
                </MoreItemsTemplate>
            </MudAutocomplete>
        </MudStack>
    }

    @if (_selectedItem.CollectionType == CollectionType.TelevisionSeason)
    {
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Saison</MudText>
            </div>
            <MudAutocomplete T="NamedMediaItemViewModel"
                             @bind-Value="_selectedItem.MediaItem" SearchFunc="@SearchTelevisionSeasons"
                             ToStringFunc="@(c => c?.Name)" Placeholder="Tapez pour rechercher…"
                             MaxItems="20">
                <MoreItemsTemplate>
                    <MudText Align="Align.Center" Class="px-4 py-1">
                        Seuls les 20 premiers éléments sont affichés
                    </MudText>
                </MoreItemsTemplate>
            </MudAutocomplete>
        </MudStack>
    }

    @if (_selectedItem.CollectionType == CollectionType.Artist)
    {
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Artiste</MudText>
            </div>
            <MudAutocomplete T="NamedMediaItemViewModel"
                             @bind-Value="_selectedItem.MediaItem" SearchFunc="@SearchArtists"
                             ToStringFunc="@(c => c?.Name)" Placeholder="Tapez pour rechercher…"
                             MaxItems="10">
                <MoreItemsTemplate>
                    <MudText Align="Align.Center" Class="px-4 py-1">
                        Seuls les 10 premiers éléments sont affichés
                    </MudText>
                </MoreItemsTemplate>
            </MudAutocomplete>
        </MudStack>
    }

    @if (_selectedItem.CollectionType == CollectionType.Playlist)
    {
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Groupe de playlists</MudText>
            </div>
            <MudSelect T="PlaylistGroupViewModel"
                       Value="@_selectedPlaylistGroup"
                       ValueChanged="@(vm => UpdatePlaylistGroupItems(vm))">
                @foreach (PlaylistGroupViewModel playlistGroup in _playlistGroups)
                {
                    <MudSelectItem Value="@playlistGroup">@playlistGroup.Name</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Playlist</MudText>
            </div>
            <MudSelect T="PlaylistViewModel" @bind-value="_selectedItem.Playlist">
                @foreach (PlaylistViewModel playlist in _playlists)
                {
                    <MudSelectItem Value="@playlist">@playlist.Name</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    }

    @if (_selectedItem.CollectionType == CollectionType.SearchQuery)
    {
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Titre de la recherche</MudText>
            </div>
            <MudTextField @bind-Value="@_selectedItem.SearchTitle"
                          For="@(() => _selectedItem.SearchTitle)"
                          HelperText="Titre facultatif affiché dans les tableaux du planning"/>
        </MudStack>
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Recherche</MudText>
            </div>
            <MudTextField @bind-Value="@_selectedItem.SearchQuery" For="@(() => _selectedItem.SearchQuery)"/>
        </MudStack>
    }

    @if (_selectedItem.CollectionType == CollectionType.RerunFirstRun)
    {
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Rediffusion (première diffusion)</MudText>
            </div>
            <MudAutocomplete T="RerunCollectionViewModel"
                             @bind-Value="_selectedItem.RerunCollection" SearchFunc="@SearchRerunCollections"
                             ToStringFunc="@(c => c?.Name)" Placeholder="Tapez pour rechercher…">
                <MoreItemsTemplate>
                    <MudText Align="Align.Center" Class="px-4 py-1">
                        Seuls les 10 premiers éléments sont affichés
                    </MudText>
                </MoreItemsTemplate>
            </MudAutocomplete>
        </MudStack>
    }

    @if (_selectedItem.CollectionType == CollectionType.RerunRerun)
    {
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Rediffusion (redif.)</MudText>
            </div>
            <MudAutocomplete T="RerunCollectionViewModel"
                             @bind-Value="_selectedItem.RerunCollection" SearchFunc="@SearchRerunCollections"
                             ToStringFunc="@(c => c?.Name)" Placeholder="Tapez pour rechercher…">
                <MoreItemsTemplate>
                    <MudText Align="Align.Center" Class="px-4 py-1">
                        Seuls les 10 premiers éléments sont affichés
                    </MudText>
                </MoreItemsTemplate>
            </MudAutocomplete>
        </MudStack>
    }

    <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
        <div class="d-flex">
            <MudText>Ordre de lecture</MudText>
        </div>
        <MudSelect @bind-Value="@_selectedItem.PlaybackOrder"
                   For="@(() => _selectedItem.PlaybackOrder)"
                   Disabled="@(_selectedItem.CollectionType is CollectionType.Playlist or CollectionType.RerunFirstRun or CollectionType.RerunRerun)">
            @switch (_selectedItem.CollectionType)
            {
                case CollectionType.MultiCollection:
                    <MudSelectItem Value="PlaybackOrder.Shuffle">Mélangé</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.ShuffleInOrder">Mélangé dans l'ordre</MudSelectItem>
                    break;
                case CollectionType.Collection:
                case CollectionType.SmartCollection:
                case CollectionType.SearchQuery:
                    <MudSelectItem Value="PlaybackOrder.Chronological">Chronologique</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.Random">Aléatoire</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.Shuffle">Mélangé</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.ShuffleInOrder">Mélangé dans l'ordre</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.Marathon">Marathon</MudSelectItem>
                    break;
                case CollectionType.TelevisionShow:
                    <MudSelectItem Value="PlaybackOrder.Chronological">Chronologique</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.SeasonEpisode">Saison, épisode</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.Random">Aléatoire</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.Shuffle">Mélangé</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.MultiEpisodeShuffle">Mélange multi-épisodes</MudSelectItem>
                    break;
                case CollectionType.Playlist:
                    <MudSelectItem Value="PlaybackOrder.None">Playlist</MudSelectItem>
                    break;
                case CollectionType.RerunFirstRun:
                    <MudSelectItem Value="PlaybackOrder.None">Aucun</MudSelectItem>
                    break;
                case CollectionType.RerunRerun:
                    <MudSelectItem Value="PlaybackOrder.None">Aucun</MudSelectItem>
                    break;
                default:
                    <MudSelectItem Value="PlaybackOrder.Chronological">Chronologique</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.Random">Aléatoire</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.Shuffle">Mélangé</MudSelectItem>
                    break;
            }
        </MudSelect>
    </MudStack>
    @if (_selectedItem.PlaybackOrder is PlaybackOrder.Marathon)
    {
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Regrouper le marathon par</MudText>
            </div>
            <MudSelect @bind-Value="@_selectedItem.MarathonGroupBy" For="@(() => _selectedItem.MarathonGroupBy)">
                <MudSelectItem Value="MarathonGroupBy.Album">Album</MudSelectItem>
                <MudSelectItem Value="MarathonGroupBy.Artist">Artiste</MudSelectItem>
                <MudSelectItem Value="MarathonGroupBy.Season">Saison</MudSelectItem>
                <MudSelectItem Value="MarathonGroupBy.Show">Série</MudSelectItem>
                <MudSelectItem Value="MarathonGroupBy.Director">Réalisateur</MudSelectItem>
            </MudSelect>
        </MudStack>
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Mélanger les groupes du marathon</MudText>
            </div>
            <MudCheckBox @bind-Value="_selectedItem.MarathonShuffleGroups"
                         For="@(() => _selectedItem.MarathonShuffleGroups)"
                         Dense="true"/>
        </MudStack>
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Mélanger les éléments du marathon</MudText>
            </div>
            <MudCheckBox @bind-Value="_selectedItem.MarathonShuffleItems"
                         For="@(() => _selectedItem.MarathonShuffleItems)"
                         Dense="true"/>
        </MudStack>
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Taille des lots du marathon</MudText>
            </div>
            <MudTextField @bind-Value="@_selectedItem.MarathonBatchSize"
                          For="@(() => _selectedItem.MarathonBatchSize)"
                          HelperText="Nombre d'éléments à lire dans chaque groupe avant de passer au suivant ; vide ou zéro = tous"/>
        </MudStack>
    }
    else if (_selectedItem.CollectionType is CollectionType.Playlist)
    {
        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Mélanger les éléments de la playlist</MudText>
            </div>
            <MudCheckBox @bind-Value="_selectedItem.MarathonShuffleGroups"
                         For="@(() => _selectedItem.MarathonShuffleGroups)"
                         Dense="true"/>
        </MudStack>
    }
    <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
        <div class="d-flex">
            <MudText>Mode de diffusion</MudText>
        </div>
        <MudSelect @bind-Value="@_selectedItem.PlayoutMode" For="@(() => _selectedItem.PlayoutMode)">
            @if (!_schedule.ShuffleScheduleItems)
            {
                <MudSelectItem Value="PlayoutMode.Flood">En continu</MudSelectItem>
            }
            <MudSelectItem Value="PlayoutMode.One">Un seul</MudSelectItem>
            <MudSelectItem Value="PlayoutMode.Multiple">Plusieurs</MudSelectItem>
            <MudSelectItem Value="PlayoutMode.Duration">Durée</MudSelectItem>
        </MudSelect>
    </MudStack>
    <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
        <div class="d-flex">
            <MudText>Mode « plusieurs »</MudText>
        </div>
        <MudSelect @bind-Value="@_selectedItem.MultipleMode"
                   For="@(() => _selectedItem.MultipleMode)"
                   Disabled="@(_selectedItem.PlayoutMode is not PlayoutMode.Multiple)">
            <MudSelectItem Value="MultipleMode.Count">Nombre</MudSelectItem>

            @if (_selectedItem.CollectionType is not CollectionType.Playlist)
            {
                <MudSelectItem Value="MultipleMode.CollectionSize">Taille de la collection</MudSelectItem>
            }
            else
            {
                <MudSelectItem Value="MultipleMode.PlaylistItemSize">Taille de l'élément</MudSelectItem>
            }

            @if (_selectedItem.PlaybackOrder is PlaybackOrder.Chronological)
            {
                <MudSelectItem Value="MultipleMode.MultiEpisodeGroupSize">Taille des groupes d'épisodes</MudSelectItem>
            }
        </MudSelect>
    </MudStack>
    <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
        <div class="d-flex">
            <MudText>Nombre d'éléments</MudText>
        </div>
        <MudTextField @bind-Value="@_selectedItem.MultipleCount"
                      For="@(() => _selectedItem.MultipleCount)"
                      Disabled="@(_selectedItem.PlayoutMode is not PlayoutMode.Multiple || _selectedItem.MultipleMode is not MultipleMode.Count)"
                      HelperText="Peut être une expression avec « count » (taille de la collection) et « random » (de 0 à count-1)"/>
    </MudStack>
    <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
        <div class="d-flex">
            <MudText>Durée de diffusion</MudText>
        </div>
        <MudTextField T="int"
                      @bind-Value="_selectedItem.PlayoutDurationHours"
                      Adornment="Adornment.End"
                      AdornmentText="hours"
