<Project>
    <PropertyGroup>
        <InformationalVersion>develop</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
        <!-- Les alertes de sécurité NuGet (paquets avec une faille connue) restent des avertissements :
             elles ne doivent pas bloquer la compilation (sinon, toute nouvelle alerte publiée casse le build). -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    </PropertyGroup>
</Project>
